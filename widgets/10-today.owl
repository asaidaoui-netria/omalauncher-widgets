          if pose == "sleep" {
            let kT = tt % 8
            let ki = len(sleepKeys.filter(k => k.t <= kT)) - 1
            let ka = sleepKeys[ki]
            let kb = sleepKeys[min(ki + 1, len(sleepKeys) - 1)]
            let ff = kb.t == ka.t ? 0 : (kT - ka.t) / (kb.t - ka.t)
            let fe = ff * ff * (3 - 2 * ff)
            let J = {uaL: lerp(ka.uaL, kb.uaL, fe), faL: lerp(ka.faL, kb.faL, fe), uaR: lerp(ka.uaR, kb.uaR, fe), faR: lerp(ka.faR, kb.faR, fe), thL: lerp(ka.thL, kb.thL, fe), shL: lerp(ka.shL, kb.shL, fe) + 6 * sin(tt * 0.7), thR: lerp(ka.thR, kb.thR, fe), shR: lerp(ka.shR, kb.shR, fe) + 6 * sin(tt * 0.7 + 1.5)}
            let hx = 103
            let hy = 28 + floor(sin(tt * 0.8) + 0.5)
            let breath = floor(0.5 + 0.5 * sin(tt * 1.3) + 0.5)
            let hdx = -1
            let hdy = floor(lerp(ka.hdy, kb.hdy, fe) + 0.5) + breath
            let eyesK = "shut"
            let mouthK = ka.mouth
            let blushOn = ka.mouth == "smile"
            // Pierrot: legs, smock, head and ruff, then the arms in front. Joints are whole cells; sleeves and legs are
            // thick lines between them (an outline pass, then the white).
            let pLegs = [[-1, J.thL, J.shL], [1, J.thR, J.shR]].map(v => {ax: hx + 3 * v[0], ay: hy, a1: v[1], a2: v[2]})
              .map(v => {ax: v.ax, ay: v.ay, bx: v.ax + floor(sin(rad(v.a1)) * 4 + 0.5), by: v.ay + floor(cos(rad(v.a1)) * 4 + 0.5), a2: v.a2})
              .map(v => {s: [[v.ax, v.ay, v.bx, v.by], [v.bx, v.by, v.bx + floor(sin(rad(v.a2)) * 4 + 0.5), v.by + floor(cos(rad(v.a2)) * 4 + 0.5)]]})
            let pArms = [[-1, J.uaL, J.faL], [1, J.uaR, J.faR]].map(v => {ax: hx + 6 * v[0], ay: hy - 10, a1: v[1], a2: v[2]})
              .map(v => {ax: v.ax, ay: v.ay, bx: v.ax + floor(sin(rad(v.a1)) * 5 + 0.5), by: v.ay + floor(cos(rad(v.a1)) * 5 + 0.5), a2: v.a2})
              .map(v => {s: [[v.ax, v.ay, v.bx, v.by], [v.bx, v.by, v.bx + floor(sin(rad(v.a2)) * 5 + 0.5), v.by + floor(cos(rad(v.a2)) * 5 + 0.5)]]})
            for L in pLegs {
              for sg in L.s {
                let n = max(abs(sg[2] - sg[0]), abs(sg[3] - sg[1]), 1)
                for ci in range(n + 1) {
                  let cx = sg[0] + floor((sg[2] - sg[0]) * ci / n + 0.5)
                  let cy = sg[1] + floor((sg[3] - sg[1]) * ci / n + 0.5)
                  rect((cx - 2) * q, (cy - 1) * q, 5 * q, 3 * q, fill: pq.o)
                  rect((cx - 1) * q, (cy - 2) * q, 3 * q, 5 * q, fill: pq.o)
                }
              }
              for sg in L.s {
                let n = max(abs(sg[2] - sg[0]), abs(sg[3] - sg[1]), 1)
                for ci in range(n + 1) {
                  rect((sg[0] + floor((sg[2] - sg[0]) * ci / n + 0.5) - 1) * q, (sg[1] + floor((sg[3] - sg[1]) * ci / n + 0.5) - 1) * q, 3 * q, 3 * q, fill: pq.w)
                }
              }
              let ex = L.s[1][2]
              let ey = L.s[1][3]
              rect((ex - 2) * q, ey * q, 5 * q, 3 * q, fill: pq.o)
              rect((ex - 1) * q, (ey + 1) * q, 3 * q, q, fill: pq.k)
            }
            sprite(pTorso, (hx - 8) * q, (hy - 11) * q, q, palette: pq)
            sprite(pHead, (hx - 6 + hdx) * q, (hy - 25 + hdy) * q, q, palette: pq)
            sprite(get(pEyes, eyesK, pEyes.open), (hx - 4 + hdx) * q, (hy - 19 + hdy) * q, q, palette: pq)
            sprite(get(pMouth, mouthK, pMouth.pout), (hx - 1 + hdx) * q, (hy - 14 + hdy) * q, q, palette: pq)
            rect((hx + 2 + hdx) * q, (hy - 15 + hdy) * q, q, q, fill: pq.t)
            if blushOn {
              rect((hx - 4 + hdx) * q, (hy - 15 + hdy) * q, q, q, fill: pq.c)
              rect((hx + 4 + hdx) * q, (hy - 15 + hdy) * q, q, q, fill: pq.c)
            }
            sprite(pRuff, (hx - 8) * q, (hy - 13) * q, q, palette: pq)
            for L in pArms {
              for sg in L.s {
                let n = max(abs(sg[2] - sg[0]), abs(sg[3] - sg[1]), 1)
                for ci in range(n + 1) {
                  let cx = sg[0] + floor((sg[2] - sg[0]) * ci / n + 0.5)
                  let cy = sg[1] + floor((sg[3] - sg[1]) * ci / n + 0.5)
                  rect((cx - 2) * q, (cy - 1) * q, 5 * q, 3 * q, fill: pq.o)
                  rect((cx - 1) * q, (cy - 2) * q, 3 * q, 5 * q, fill: pq.o)
                }
              }
              for sg in L.s {
                let n = max(abs(sg[2] - sg[0]), abs(sg[3] - sg[1]), 1)
                for ci in range(n + 1) {
                  rect((sg[0] + floor((sg[2] - sg[0]) * ci / n + 0.5) - 1) * q, (sg[1] + floor((sg[3] - sg[1]) * ci / n + 0.5) - 1) * q, 3 * q, 3 * q, fill: pq.w)
                }
              }
              let ex = L.s[1][2]
              let ey = L.s[1][3]
              rect((ex - 2) * q, (ey - 2) * q, 5 * q, 5 * q, fill: pq.o)
              rect((ex - 1) * q, (ey - 1) * q, 3 * q, 3 * q, fill: pq.s)
              rect(ex * q, ey * q, q, q, fill: pq.f)
            }
            for n in range(3) {
              let u = (tt * 0.28 + n / 3) % 1
              let zy = floor(hy - 26 - 16 * u + 0.5)
              if zy >= 0 {
                sprite(zzArt, floor(hx + 4 + 12 * u + 2 * sin(tt * 2 + n) + 0.5) * q, zy * q, q, palette: {y: alpha(foreground, 1 - u)})
              }
            }
            // The dream: bubbles drift up beside his head to a little full moon, while he smiles.
            if kT >= 3.6 && kT < 6.8 {
              let u = min(1, (kT - 3.6) / 0.6)
              rect((hx - 9) * q, (hy - 21) * q, q, q, fill: alpha(foreground, 0.55))
              if u > 0.45 {
                rect((hx - 13) * q, (hy - 23) * q, 2 * q, 2 * q, fill: alpha(foreground, 0.55))
              }
              if u >= 1 {
                for dy in range(-4, 5) {
                  let hw = floor(sqrt(20 - dy * dy))
                  rect((hx - 22 - hw) * q, (hy - 25 + dy) * q, (2 * hw + 1) * q, q, fill: alpha(foreground, 0.16))
                }
                for dy in range(-2, 3) {
                  let hw = floor(sqrt(6 - dy * dy))
                  rect((hx - 22 - hw) * q, (hy - 25 + dy) * q, (2 * hw + 1) * q, q, fill: mix(yellow, foreground, 0.6))
                }
              }
            }
          }
          path(range(2 * 161).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
          path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
        }
      }
      Row {
        gap: 0
        Canvas {
          weight: 80
          height: 16 * screenWidth / 160
          let q = width / 80
          let rowsN = floor(height / q)
          rect(0, 0, width, height, fill: alpha(foreground, 0.05))
          path(range(2 * 81).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
          path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
        }
        // yr.no (Norwegian Meteorological Institute): ad-free and worldwide, opened at wttr's coordinates.
        Canvas {
          weight: 80
          height: 16 * screenWidth / 160
          onTap: url("https://www.yr.no/en/forecast/daily-table/${area.latitude},${area.longitude}")
          let q = width / 80
          let rowsN = floor(height / q)
          let t = "OPEN YR.NO ↗"
          rect(0, 0, width, height, fill: alpha(foreground, 0.05))
          rect((76 - len(t) * 4 - 6) * q, 3 * q, (len(t) * 4 + 7) * q, 11 * q, fill: alpha(accent, 0.18))
          for j in range(len(t)) {
            sprite(get(font, sub(t, j, j + 1), unknownGlyph), (76 - len(t) * 4 - 2 + j * 4) * q, 6 * q, q, color: accent)
          }
          path(range(2 * 81).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
          path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
        }
      }
    }
  }
}
