widget "today" {
  page: 1
  order: 1
  size: 6x2
  minSize: 6x2
  padding: 12
  meta { description: "The date and the weather where you are, from wttr.in and Open-Meteo, located by IP, or at a place you search for. Tap it for hourly charts, five days, wind, UV, the sun and moon, and Pierrot on the moon"; version: "2.0"; license: "MIT"; category: "world"; owl: 5 }

  source now = clock every 1m
  // Animations play for 30 s after the page comes back into view (the screen turned on, back from an app or from
  // two pages away) or after a tap, then rest on a still frame: while a canvas animates, the launcher redraws
  // every frame, which costs it more than a core.
  source wakeClock = clock every 1s
  state wakeAt = 0
  on wakeClock { wakeAt = value - old > 4 ? value : wakeAt }
  when wakeAt == 0 && wakeClock > 0 { wakeAt = wakeClock }
  let animOn = wakeClock - wakeAt < 30
  // Where you are: ipinfo.io's coordinates follow you by network (wttr's own IP guess wanders between districts),
  // and a place picked on the full screen overrides them. Widgets can't read GPS (yet: omalauncher issue #31).
  // Icons and °F countries match omarchy's weather panel.
  source geo = http("https://ipinfo.io/json") every 30m timeout 10s json
  state place = "" persist
  // Picking a place: the screen's box searches Photon (OpenStreetMap's place names, forgiving of typos) for
  // cities and towns and lists them under it, cities first; tapping one pins its coordinates and its name.
  state query = ""
  state placeName = "" persist
  // Typing searches by itself a second or two after the last key (a search refreshes every source, as nothing
  // narrower exists); the keyboard's send key searches at once.
  state searchAt = 0
  at searchAt { refresh() }
  source found = http("https://photon.komoot.io/api/?q=${replace(trim(query), " ", "+")}&limit=8&lang=en&layer=city", {"User-Agent": "omalauncher-weather-widget (+https://github.com/asaidaoui-netria/omalauncher-widgets)"}) every 1h timeout 10s json status
  let hits = (found.ok ? found.out.features ?? [] : []).map(f => {name: f.properties.name, kind: f.properties.osm_value, lat: fixed(f.geometry.coordinates[1], 4), lon: fixed(f.geometry.coordinates[0], 4), label: replace(join([f.properties.name, f.properties.state, f.properties.country].filter(x => x != null && x != ""), ", "), "–", "-")})
  let ranked = hits.filter(h => h.kind == "city") + hits.filter(h => h.kind != "city")
  let picks = unique(ranked.map(h => h.label)).take(5).map(l => ranked.find(h => h.label == l))
  source wx = http("https://wttr.in/${place != "" ? replace(trim(place), " ", "+") : geo.loc ?? ""}?format=j1") every 15m timeout 10s json
  let cur = wx.current_condition[0]
  let day = wx.weather[0]
  let area = wx.nearest_area[0]
  // wttr's nearest area is often a district or a region miles off, so name the place ourselves:
  // OpenStreetMap's town at ipinfo's coordinates, the picked name for a pinned place.
  let spot = split(geo.loc ?? "0,0", ",").map(x => fixed(num(x), 3))
  source named = http("https://nominatim.openstreetmap.org/reverse?format=jsonv2&zoom=10&accept-language=en&lat=${spot[0]}&lon=${spot[1]}", {"User-Agent": "omalauncher-weather-widget (+https://github.com/asaidaoui-netria/omalauncher-widgets)"}) every 30m timeout 10s json
  let osm = named.address.city ?? named.address.town ?? named.address.village ?? named.address.county
  let town = place == "" ? osm ?? geo.city ?? area.areaName[0].value : placeName != "" ? placeName : area.areaName[0].value
  let imperial = contains(["united states", "united states of america", "liberia", "myanmar", "burma"], lower(trim(area.country[0].value)))
  let unit = imperial ? "F" : "C"
  let night = contains(cur.weatherIconUrl[0].value, "_night")
  let hourNow = num(fmtTime(now, "H"))
  // The day list: wttr's three days (as on the tile), then Open-Meteo's at the same place for days
  // four and five, since wttr stops at three. Its WMO weather codes map to wttr's for weatherIcon.
  // A picked place is pinned as "lat,lon", so Open-Meteo gets its coordinates at once (a name pinned by an
  // older version uses wttr's).
  let pinAt = match(place, "^(-?[0-9.]+),(-?[0-9.]+)$")
  let coords = place != "" ? (pinAt ?? [area.latitude, area.longitude]) : split(geo.loc ?? ",", ",")
  // Changing the place or the coordinates doesn't refetch by itself (it waits for each source's next fetch), so
  // fetch now when either moves.
  state fetchedFor = ""
  let fetchKey = "${place}|${coords[0]},${coords[1]}"
  when coords[0] != null && coords[0] != "" && fetchKey != fetchedFor { fetchedFor = fetchKey; refresh() }
  source om = http("https://api.open-meteo.com/v1/forecast?latitude=${coords[0]}&longitude=${coords[1]}&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=auto&forecast_days=5${imperial ? "&temperature_unit=fahrenheit" : ""}") every 1h timeout 10s json status
  // Hourly for the next 48 hours, in Unix time so the hours land on the phone's clock (wttr's can be an hour off).
  source omh = http("https://api.open-meteo.com/v1/forecast?latitude=${coords[0]}&longitude=${coords[1]}&hourly=temperature_2m,precipitation_probability,precipitation,weather_code,uv_index,wind_speed_10m,wind_direction_10m,wind_gusts_10m,relative_humidity_2m,dew_point_2m,pressure_msl,visibility,is_day&forecast_hours=48&timeformat=unixtime${imperial ? "&temperature_unit=fahrenheit&wind_speed_unit=mph&precipitation_unit=inch" : ""}") every 30m timeout 10s json status
  let wmo = {
    "0": "113", "1": "113", "2": "116", "3": "122", "45": "248", "48": "260",
    "51": "266", "53": "266", "55": "266", "56": "281", "57": "284",
    "61": "296", "63": "302", "65": "308", "66": "311", "67": "314",
    "71": "326", "73": "332", "75": "338", "77": "326",
    "80": "353", "81": "356", "82": "359", "85": "368", "86": "371",
    "95": "386", "96": "389", "99": "389"
  }
  let daily = om.ok == true ? om.out.daily : null
  let hr0 = omh.ok == true ? omh.out.hourly : null
  let hourly = hr0 == null || len(hr0.time ?? []) == 0 ? null : range(len(hr0.time)).map(i => {
    t: hr0.time[i],
    temp: round(hr0.temperature_2m[i]),
    pop: hr0.precipitation_probability[i] ?? 0,
    mm: hr0.precipitation[i] ?? 0,
    code: get(wmo, str(hr0.weather_code[i]), "116"),
    uv: hr0.uv_index[i] ?? 0,
    ws: round(hr0.wind_speed_10m[i]),
    wd: hr0.wind_direction_10m[i] ?? 0,
    wg: round(hr0.wind_gusts_10m[i]),
    rh: hr0.relative_humidity_2m[i],
    dp: round(hr0.dew_point_2m[i]),
    p: hr0.pressure_msl[i],
    vis: hr0.visibility[i] ?? 0,
    day: hr0.is_day[i] == 1
  })
  // A fetch that failed or came back empty would otherwise leave days or hours missing until the next one:
  // while either is missing, try again every two minutes (only while the page is on screen).
  state detail = ""
  state openedAt = -100
  state hScroll = 0
  let omMissing = (daily == null || hourly == null) && coords[0] != ""
  when omMissing && floor(now / 60) % 2 == 0 { refresh() }
  let later = daily == null ? [] : range(len(daily.time)).map(i => {
    date: daily.time[i],
    code: get(wmo, str(daily.weather_code[i]), "116"),
    rain: num(daily.precipitation_probability_max[i], 0),
    lo: round(daily.temperature_2m_min[i], 0),
    hi: round(daily.temperature_2m_max[i], 0)
  })
  let forecast = ((wx.weather ?? []).map(d => {
    date: d.date,
    code: d.hourly[4].weatherCode,
    rain: max(d.hourly.map(h => num(h.chanceofrain))),
    lo: num(get(d, "mintemp" + unit)),
    hi: num(get(d, "maxtemp" + unit))
  }) + drop(later, len(wx.weather ?? [])))
  // The listed days' range, so their bars share one scale.
  let lowest = min(forecast.map(d => d.lo))
  let highest = max(forecast.map(d => d.hi))
  let uv = num(cur.uvIndex)

  // The tile: one dot-matrix panel with the phone tile's cell size. A split-flap board shows the date
  // (it clatters into place each time the page comes into view), and the weather plays as a little
  // pixel scene beside the temperature. Layout in cells: 175 x 47.
  let cell = min(((tileWidth ?? 364) - 24) / 175, ((tileHeight ?? 117) - 24) / 47)
  let flipSet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
  let blankGlyph = ["...", "...", "...", "...", "..."]
  // wttr's weather codes, by what the scene should show.
  let code = cur.weatherCode ?? "116"
  let kind = code == "113" ? "clear" : code == "116" ? "partly" : contains(["119", "122"], code) ? "cloudy" : contains(["143", "248", "260"], code) ? "fog" : contains(["200", "386", "389", "392", "395"], code) ? "storm" : contains(["179", "182", "185", "227", "230", "317", "320", "323", "326", "329", "332", "335", "338", "350", "362", "365", "368", "371", "374", "377"], code) ? "snow" : "rain"
  let tNow = get(cur, "temp_" + unit)
  let tC = imperial ? (num(tNow) - 32) * 5 / 9 : num(tNow)
  let tColor = tC < 5 ? blue : tC < 16 ? cyan : tC < 24 ? green : tC < 30 ? yellow : tC < 35 ? orange : red
  let tStr = cur == null ? "--°" : "${tNow}°"
  let tk = len(tStr) > 3 ? 2 : 3
  let board = [
    {t: upper(fmtTime(now, "EEE")), x: 0, y: 0, c: accent, g: 0},
    {t: fmtTime(now, "dd"), x: 48, y: 0, c: foreground, g: 3},
    {t: upper(fmtTime(now, "MMM")), x: 0, y: 17, c: foreground, g: 5},
    {t: fmtTime(now, "yyyy"), x: 30, y: 17, c: mix(foreground, background, 0.25), g: 8}
  ]
  // Text that may not fit its 46 cells scrolls like a marquee.
  let ticker = [
    {t: cur == null ? (wx == null ? "WEATHER..." : "OFFLINE") : upper(trim(cur.weatherDesc[0].value)), y: 5, c: foreground},
    {t: upper(town ?? ""), y: 40, c: muted}
  ]
  let starX = [3, 9, 31, 40, 44, 14, 36]
  let starY = [3, 12, 2, 9, 20, 24, 27]
  let snowX = [2, 15, 7, 19, 11, 4, 17, 9, 21, 13]

  // The sky: where the sun and moon really are, from the clock and your coordinates (a low-precision
  // almanac, good to a degree or so: it gives wttr's rise and set times to the minute), and the moon's
  // phase. It moves on its own, recomputed with the clock while the page is on screen.
  let lat = num(coords[0], 999)
  let lon = num(coords[1], 999)
  let haveSky = lat < 900 && lon < 900 && now != null
  let jd = now / 86400 - 10957.5
  let eps = rad(23.439)
  let gmst = (280.46061837 + 360.98564736629 * jd) % 360
  let sg = rad(357.529 + 0.98560028 * jd)
  let mM = rad(134.963 + 13.064993 * jd)
  let mD = rad(297.850 + 12.190749 * jd)
  let sunLon = 280.459 + 0.98564736 * jd + 1.915 * sin(sg) + 0.020 * sin(2 * sg)
  let moonLon = 218.316 + 13.176396 * jd + 6.289 * sin(mM) + 1.274 * sin(2 * mD - mM) + 0.658 * sin(2 * mD) - 0.186 * sin(sg) - 0.059 * sin(2 * mD - 2 * mM) - 0.057 * sin(2 * mD - mM - sg)
  let moonLat = 5.128 * sin(rad(93.272 + 13.229350 * jd))
  // Ecliptic to equatorial to the local sky: altitude, and azimuth from north, clockwise (degrees).
  let bodies = [[sunLon, 0], [moonLon, moonLat]]
    .map(b => {lr: rad(b[0]), br: rad(b[1])})
    .map(b => {ra: deg(atan2(sin(b.lr) * cos(eps) - sin(b.br) / cos(b.br) * sin(eps), cos(b.lr))), sd: sin(b.br) * cos(eps) + cos(b.br) * sin(eps) * sin(b.lr)})
    .map(b => {ra: b.ra, dec: atan2(b.sd, sqrt(max(0, 1 - b.sd * b.sd))), h: rad(gmst + lon - b.ra)})
    .map(b => {ra: b.ra, dec: b.dec, h: b.h, sa: sin(rad(lat)) * sin(b.dec) + cos(rad(lat)) * cos(b.dec) * cos(b.h)})
    .map(b => {ra: b.ra, dec: b.dec, alt: deg(atan2(b.sa, sqrt(max(0, 1 - b.sa * b.sa)))), az: (deg(atan2(-cos(b.dec) * sin(b.h), sin(b.dec) * cos(rad(lat)) - cos(b.dec) * cos(b.h) * sin(rad(lat)))) + 360) % 360})
  // In the scene, facing the equator: east on the left, west on the right; higher in the sky, higher up.
  let skyPos = bodies.map(b => {x: clamp(24 + (((lat < 0 ? b.az + 180 : b.az) % 360) - 180) / 110 * 22, -8, 56), y: 36 - round(sin(rad(max(b.alt, -20))) * 29)})
  let sunAlt = haveSky ? bodies[0].alt : (night ? -20 : 40)
  let moonAlt = haveSky ? bodies[1].alt : (night ? 40 : -90)
  let sunXY = haveSky ? skyPos[0] : {x: 24, y: 17}
  let moonXY = haveSky ? skyPos[1] : {x: 24, y: 17}
  // Night in the sky scenes: the sun is drawn down to 4 degrees under the horizon, the moon only past that, so the
  // two never share the sky.
  let dark = sunAlt < -4
  // The moon's phase from its angle to the sun (0 new, 180 full), lit on the sun's side: the right while
  // waxing (north of the equator). Drawn cell by cell on a 13-cell disc; d is the earthshine-dim rest.
  let elong = ((moonLon - sunLon) % 360 + 360) % 360
  let moonLit = round((1 - cos(rad(elong))) / 2 * 100)
  let ct = cos(rad(elong))
  let sgn = (elong < 180 ? 1 : -1) * (lat < 0 ? -1 : 1)
  let moonNow = range(13).map(j => join(range(13).map(i => (i - 6) * (i - 6) + (j - 6) * (j - 6) > 42.25 ? "." : sgn * (i - 6) > sqrt(max(0, 42.25 - (j - 6) * (j - 6))) * ct ? "l" : "d"), ""))
  // Sunrise and sunset from the same almanac, as Unix times. wttr's own are in its idea of the local
  // time, which can be an hour off the phone's; the gap between the two sunrises puts wttr's hours on the phone's clock.
  let L0 = (280.459 + 0.98564736 * jd) % 360
  let eotMin = ((((L0 - bodies[0].ra) % 360) + 540) % 360 - 180) * 4
  let noonMin = 720 - 4 * lon - eotMin
  let cosH0 = (sin(rad(-0.833)) - sin(rad(lat)) * sin(bodies[0].dec)) / (cos(rad(lat)) * cos(bodies[0].dec))
  let h0 = abs(cosH0) <= 1 ? deg(atan2(sqrt(1 - cosH0 * cosH0), cosH0)) : null
  let dayStart = now - now % 86400
  let riseTs = haveSky && h0 != null ? dayStart + round((noonMin - 4 * h0) * 60) : null
  let setTs = haveSky && h0 != null ? dayStart + round((noonMin + 4 * h0) * 60) : null
  let riseH = riseTs == null ? 6 : num(fmtTime(riseTs, "H")) + num(fmtTime(riseTs, "m")) / 60
  let setH = setTs == null ? 18 : num(fmtTime(setTs, "H")) + num(fmtTime(setTs, "m")) / 60
  let wttrRise = match(day.astronomy[0].sunrise ?? "", "(\\d+):(\\d+) (AM|PM)")
  let wttrRiseH = wttrRise == null ? null : num(wttrRise[0]) % 12 + (wttrRise[2] == "PM" ? 12 : 0) + num(wttrRise[1]) / 60
  let offH = wttrRiseH == null || riseTs == null ? 0 : round(wttrRiseH - riseH)
  // The next 24 hours in wttr's 3-hour steps, from today's and tomorrow's forecasts, on the phone's clock.
  let steps = flatten(range(2).map(i => (wx.weather[i].hourly ?? []).map(h => {
    hr: i * 24 + num(h.time) / 100 - offH,
    t: num(get(h, "temp" + unit)),
    rain: num(h.chanceofrain),
    code: h.weatherCode
  }))).filter(s => s.hr > hourNow - 3).take(8)
  let tLo = min(steps.map(s => s.t))
  let tHi = max(steps.map(s => s.t))
  // wttr's codes by what to draw, for the screen's small icons (7x7: y sun, m moon, w cloud, c rain).
  let kindOf = {
    "113": "clear", "116": "partly", "119": "cloudy", "122": "cloudy", "143": "fog", "248": "fog", "260": "fog",
    "200": "storm", "386": "storm", "389": "storm", "392": "storm", "395": "storm",
    "179": "snow", "182": "snow", "185": "snow", "227": "snow", "230": "snow", "317": "snow", "320": "snow",
    "323": "snow", "326": "snow", "329": "snow", "332": "snow", "335": "snow", "338": "snow", "350": "snow",
    "362": "snow", "365": "snow", "368": "snow", "371": "snow", "374": "snow", "377": "snow"
  }
  let icons = {
    clear: ["y..y..y", ".yyyyy.", ".yyyyy.", "yyyyyyy", ".yyyyy.", ".yyyyy.", "y..y..y"],
    clearN: ["..mmm..", ".mm....", "mm.....", "mm.....", "mm.....", ".mm....", "..mmm.."],
    partly: ["...y.y.", "....yyy", "..wwyyy", ".wwwwwy", "wwwwwww", "wwwwwww", "......."],
    partlyN: ["....mm.", "...mm..", "..wwm..", ".wwwwwm", "wwwwwww", "wwwwwww", "......."],
    cloudy: [".......", "..www..", ".wwwww.", "wwwwwww", "wwwwwww", ".......", "......."],
    rain: ["..www..", ".wwwww.", "wwwwwww", ".......", ".c.c.c.", "c.c.c..", "......."],
    storm: ["..www..", ".wwwww.", "wwwwwww", "...y...", "..yy...", "...y...", "..y...."],
    snow: ["..www..", ".wwwww.", "wwwwwww", ".......", ".w.w.w.", "..w.w..", ".w.w.w."],
    fog: [".......", "wwwww..", ".......", "..wwwww", ".......", "wwwww..", "......."]
  }
  let iconPal = {y: yellow, m: mix(yellow, foreground, 0.55), w: alpha(foreground, 0.85), c: cyan}
  // The moon, in words: its phase and when it's next full.
  let phaseName = elong < 11.25 || elong >= 348.75 ? "NEW MOON" : elong < 78.75 ? "WAXING CRESCENT" : elong < 101.25 ? "FIRST QUARTER" : elong < 168.75 ? "WAXING GIBBOUS" : elong < 191.25 ? "FULL MOON" : elong < 258.75 ? "WANING GIBBOUS" : elong < 281.25 ? "LAST QUARTER" : "WANING CRESCENT"
  // The next full moon: the moon's speed varies, so look ahead in 3-hour steps for elongation passing 180.
  let fullTs = (range(1, 241).map(k => now + k * 10800)
    .map(t => {t: t, d: t / 86400 - 10957.5})
    .map(o => {t: o.t, d: o.d, g: rad(357.529 + 0.98560028 * o.d), mm: rad(134.963 + 13.064993 * o.d), md: rad(297.850 + 12.190749 * o.d)})
    .map(o => {t: o.t, e: (((218.316 + 13.176396 * o.d + 6.289 * sin(o.mm) + 1.274 * sin(2 * o.md - o.mm) + 0.658 * sin(2 * o.md) - 0.186 * sin(o.g) - 0.059 * sin(2 * o.md - 2 * o.mm) - 0.057 * sin(2 * o.md - o.mm - o.g)) - (280.459 + 0.98564736 * o.d + 1.915 * sin(o.g) + 0.020 * sin(2 * o.g))) % 360 + 360) % 360})
    .find(o => o.e >= 180 && o.e < 182.5)).t
  // The screen's text rows: 160 cells across, so 40 characters at the small size.
  let wxDesc = cur == null ? (wx == null ? "WEATHER..." : "OFFLINE") : upper(trim(cur.weatherDesc[0].value))
  let viaText = place != "" ? "PINNED PLACE" : "BY NETWORK, ROUGHLY"
  // The conditions, from Open-Meteo's current hour (so a tile matches its hourly chart), or wttr's while it loads.
  let hn = hourly == null ? null : hourly[0]
  let next24 = hourly == null ? [] : hourly.take(24)
  let lastOffs = hourly == null ? 0 : max(len(hourly) - 12, 0)
  let dirs16 = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]
  let wsUnit = imperial ? "MPH" : "KM/H"
  let uvNow = hn == null ? uv : hn.uv
  let uvR = round(uvNow)
  let pTrend = hourly == null || len(hourly) < 4 ? 0 : hourly[3].p - hourly[0].p
  let rain24 = max(next24.map(h => h.pop))
  let mm24 = sum(next24.map(h => h.mm))
  let uvHigh = next24.filter(h => h.uv >= 3)
  let wetHour = next24.sortBy(h => -h.pop)[0]
  let minVis = min(next24.map(h => h.vis))
  let wxCond = cur == null && hn == null ? [] : [
    {m: "wind", l: "WIND ${hn == null ? upper(cur.winddir16Point ?? "") : dirs16[round(hn.wd / 22.5) % 16]}", v: hn == null ? (imperial ? "${cur.windspeedMiles} MPH" : "${cur.windspeedKmph} KM/H") : "${hn.ws} ${wsUnit}", c: cyan},
    {m: "humidity", l: "HUMIDITY", v: "${hn == null ? cur.humidity : hn.rh}%", c: blue},
    {m: "rain", l: hn == null ? "RAIN · ${imperial ? cur.precipInches + " IN" : cur.precipMM + " MM"}" : "RAIN 24H · ${fixed(mm24, 1)} ${imperial ? "IN" : "MM"}", v: "${hn == null ? max(day.hourly.map(h => num(h.chanceofrain))) : rain24}%", c: blue},
    {m: "uv", l: "UV · ${uvR >= 11 ? "EXTREME" : uvR >= 8 ? "VERY HIGH" : uvR >= 6 ? "HIGH" : uvR >= 3 ? "MODERATE" : "LOW"}", v: "${uvR}", c: uvR >= 8 ? red : uvR >= 6 ? orange : uvR >= 3 ? yellow : green},
    {m: "pressure", l: "PRESSURE${pTrend > 0.5 ? " ↑" : pTrend < -0.5 ? " ↓" : ""}", v: hn == null ? (imperial ? "${cur.pressureInches} INHG" : "${cur.pressure} HPA") : imperial ? "${fixed(hn.p * 0.02953, 2)} INHG" : "${round(hn.p)} HPA", c: foreground},
    {m: "visibility", l: "VISIBILITY", v: hn == null ? (imperial ? "${cur.visibilityMiles} MI" : "${cur.visibility} KM") : imperial ? "${round(hn.vis / 1609)} MI" : "${round(hn.vis / 1000)} KM", c: foreground}
  ]
  // What an opened tile shows: a title and a one-line summary over the hourly chart.
  let detailInfo = {
    wind: {t: "WIND", s: hourly == null ? "" : "GUSTS UP TO ${max(next24.map(h => h.wg))} ${wsUnit}"},
    humidity: {t: "HUMIDITY %", s: hn == null ? "" : "DEW POINT ${hn.dp}° · ${hn.dp >= 20 ? "MUGGY" : hn.dp >= 16 ? "HUMID" : hn.dp >= 10 ? "COMFORTABLE" : "DRY"}"},
    rain: {t: "CHANCE OF RAIN %", s: rain24 < 10 ? "NO RAIN EXPECTED" : "MOST LIKELY ${fmtTime(wetHour.t, "HH")}:00 · ${wetHour.pop}%"},
    uv: {t: "UV INDEX", s: len(uvHigh) == 0 ? "LOW ALL DAY" : "PROTECT ${fmtTime(first(uvHigh).t, "HH")}-${fmtTime(last(uvHigh).t + 3600, "HH")}H"},
    pressure: {t: "PRESSURE ${imperial ? "INHG" : "HPA"}", s: "${pTrend > 0.5 ? "RISING" : pTrend < -0.5 ? "FALLING" : "STEADY"} ${pTrend >= 0 ? "+" : ""}${fixed(pTrend, 1)} HPA IN 3H"},
