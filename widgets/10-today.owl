  ]

  onTap: { wakeAt = wakeClock; screen() }

  Box {
    fill: true
    // The still layer, drawn once: the date board as it stands, the divider, the temperature and text.
    Canvas {
      fill: true
      let p = cell
      let ox = floor((width / p - 175) / 2)
      let oy = floor((height / p - 47) / 2)
      rect(0, 0, width, height, fill: alpha(foreground, 0.05))
      for w in board {
        for j in range(len(w.t)) {
          let cx = ox + 3 + w.x + j * 9
          let cy = oy + 8 + w.y
          rect(cx * p, cy * p, 8 * p, 14 * p, fill: mix(background, foreground, 0.16))
          sprite(get(font, sub(w.t, j, j + 1), blankGlyph), (cx + 1) * p, (cy + 2) * p, 2 * p, color: w.c)
          line(cx * p, (cy + 7) * p, (cx + 8) * p, (cy + 7) * p, stroke: background, width: p * 0.7)
        }
      }
      for j in range(23) {
        rect((ox + 72) * p, (oy + 1 + j * 2) * p, p, p, fill: alpha(muted, 0.25))
      }

      // Beside it: conditions, the temperature (its color from cold blue to hot red), today's high and low, the town.
      let tx = ox + 128
      for i in range(len(tStr)) {
        sprite(get(font, sub(tStr, i, i + 1), blankGlyph), (tx + i * 4 * tk) * p, (oy + 13) * p, tk * p, color: tColor)
      }
      if cur != null {
        let hiT = "↑${get(day, "maxtemp" + unit)}°"
        let loT = "↓${get(day, "mintemp" + unit)}°"
        for i in range(len(hiT)) {
          sprite(get(font, sub(hiT, i, i + 1), blankGlyph), (tx + i * 4) * p, (oy + 32) * p, p, color: i == 0 ? orange : foreground)
        }
        for i in range(len(loT)) {
          sprite(get(font, sub(loT, i, i + 1), blankGlyph), (tx + 20 + i * 4) * p, (oy + 32) * p, p, color: i == 0 ? cyan : muted)
        }
      }
      for it in ticker {
        if len(it.t) * 4 <= 46 {
          for i in range(len(it.t)) {
            sprite(get(font, sub(it.t, i, i + 1), blankGlyph), (tx + i * 4) * p, (oy + it.y) * p, p, color: it.c)
          }
        }
      }
    }
    // The moving layer: cards still flipping, the weather scene, a long line scrolling, and the grid on top.
    Canvas {
      fill: true
      let p = cell
      let ox = floor((width / p - 175) / 2)
      let oy = floor((height / p - 47) / 2)
      let tt = animOn ? time : 6
      for w in board {
        for j in range(len(w.t)) {
          let gi = w.g + j
          let cx = ox + 3 + w.x + j * 9
          let cy = oy + 8 + w.y
          let t0 = 0.25 + gi * 0.06
          let nFlips = 4 + (gi * 3) % 4
          let u = tt - t0
          let flipping = u >= 0 && u < nFlips * 0.07
          if u < nFlips * 0.07 {
          let r = (gi * 7 + floor(u / 0.07) * 11) % 36
          let ch = u < 0 ? " " : flipping ? sub(flipSet, r, r + 1) : sub(w.t, j, j + 1)
          rect(cx * p, cy * p, 8 * p, 14 * p, fill: mix(background, foreground, 0.16))
          sprite(get(font, ch, blankGlyph), (cx + 1) * p, (cy + 2) * p, 2 * p, color: w.c)
          if flipping {
            // The falling flap folds over the top half, then unfolds over the bottom.
            let f = (u % 0.07) / 0.07
            if f < 0.5 {
              rect(cx * p, (cy + floor(f * 14)) * p, 8 * p, (7 - floor(f * 14)) * p, fill: mix(background, foreground, 0.32))
            }
            if f >= 0.5 {
              rect(cx * p, (cy + 7) * p, 8 * p, floor((f - 0.5) * 14) * p, fill: mix(background, foreground, 0.32))
            }
          }
          // The split between the two flaps.
          line(cx * p, (cy + 7) * p, (cx + 8) * p, (cy + 7) * p, stroke: background, width: p * 0.7)
          }
        }
      }
      // The weather, as a scene: 48 x 38 cells, with a ground line.
      let sx = ox + 76
      let sy = oy + 4
      let gr = sy + 36
      let bright = kind == "partly" || kind == "cloudy" || kind == "fog"
      let cFill = bright ? mix(foreground, background, dark ? 0.4 : 0.12) : mix(foreground, background, 0.48)
      let cShade = bright ? mix(foreground, background, dark ? 0.62 : 0.42) : mix(foreground, background, 0.7)
      let cTop = bright ? foreground : mix(foreground, background, 0.3)
      let flash = kind == "storm" && (tt % 4.2 < 0.12 || (tt % 4.2 > 0.22 && tt % 4.2 < 0.3))
      clip(sx * p, sy * p, 48 * p, 38 * p) {
        if flash {
          rect(sx * p, sy * p, 48 * p, 38 * p, fill: alpha(foreground, 0.14))
        }
        // What of the sky shows through: all of it when clear or partly cloudy, the sun's disc through fog.
        let skyOpen = kind == "clear" || kind == "partly"
        let veil = kind == "fog" ? 0.35 : 1
        // Twilight: the horizon glows while the sun is just under or over it.
        let dusk = clamp(1 - abs(sunAlt + 1) / 8, 0, 1)
        if skyOpen && dusk > 0 {
          for k in range(8) {
            rect(sx * p, (gr - 1 - k) * p, 48 * p, p, fill: alpha(orange, dusk * (0.3 - k * 0.035)))
          }
        }
        // Stars fade in through twilight.
        if skyOpen && sunAlt < -2 {
          for k in range(7) {
            rect((sx + starX[k]) * p, (sy + starY[k]) * p, p, p, fill: alpha(foreground, clamp((-sunAlt - 2) / 8, 0, 1) * (0.2 + 0.6 * abs(sin(tt * 1.3 + k * 2.1)))))
          }
        }
        // The moon and the sun where they are, cut off by the horizon (paler by day, for the moon).
        clip(sx * p, sy * p, 48 * p, (gr - sy) * p) {
          if (skyOpen || kind == "fog") && moonAlt > -4 && dark {
            let mx = sx + round(moonXY.x)
            let my = sy + moonXY.y
            sprite(moonNow, (mx - 6) * p, (my - 6) * p, p, palette: {l: alpha(mix(yellow, foreground, 0.55), veil), d: alpha(foreground, veil * 0.12)})
          }
          if (skyOpen || kind == "fog") && sunAlt > -4 {
            let bx = sx + round(sunXY.x)
            let by = sy + sunXY.y
            if skyOpen {
              for k in range(8) {
                let a = rad(k * 45 + tt * 25)
                for rr in range(2 + (k + floor(tt * 2)) % 2) {
                  rect(round(bx + cos(a) * (8 + rr)) * p, round(by + sin(a) * (8 + rr)) * p, p, p, fill: alpha(yellow, 0.9 - rr * 0.3))
                }
              }
            }
            sprite(sunArt, (bx - 6) * p, (by - 6) * p, p, palette: {b: alpha(yellow, veil), s: alpha(orange, veil), h: alpha(mix(yellow, foreground, 0.6), veil)})
          }
        }
        // Clouds: one drifting across the sun, or a slow sky of them.
        if kind == "partly" {
          sprite(cloudBig, (sx + 20 + round(sin(tt * 0.35) * 5)) * p, (sy + 15) * p, p, palette: {b: cFill, s: cShade, h: cTop})
        }
        if kind == "cloudy" || kind == "rain" || kind == "snow" || kind == "storm" {
          sprite(cloudSmall, (sx - 16 + floor((tt * 2.2) % 64)) * p, (sy + 2) * p, p, palette: {b: cShade, s: mix(cShade, background, 0.4), h: cFill})
          sprite(cloudBig, (sx + 12 + round(sin(tt * 0.4) * (kind == "cloudy" ? 4 : 2))) * p, (sy + 6) * p, p, palette: {b: cFill, s: cShade, h: cTop})
        }
        if kind == "cloudy" {
          sprite(cloudSmall, (sx + 47 - floor((tt * 3.1 + 20) % 64)) * p, (sy + 18) * p, p, palette: {b: cFill, s: cShade, h: cTop})
        }
        // Rain falls from the cloud and splashes on the ground; storms add lightning.
        if kind == "rain" || kind == "storm" {
          for k in range(9) {
            let dx = sx + 14 + (k * 5) % 22
            let t = (tt * 1.6 + k * 0.37) % 1
            let dy = sy + 16 + floor(t * 20)
            if dy < gr - 1 {
              rect(dx * p, dy * p, p, 2 * p, fill: alpha(cyan, 0.85))
            }
            if t > 0.93 {
              rect((dx - 1) * p, (gr - 1) * p, p, p, fill: alpha(cyan, 0.6))
              rect((dx + 1) * p, (gr - 1) * p, p, p, fill: alpha(cyan, 0.6))
            }
          }
        }
        if flash {
          sprite(boltArt, (sx + 20) * p, (sy + 15) * p, 2 * p, palette: {y: yellow})
        }
        // Snow drifts down, swaying.
        if kind == "snow" {
          for k in range(10) {
            let t = (tt * 0.35 + k * 0.29) % 1
            let fx = sx + 13 + snowX[k] + round(sin(tt * 2 + k) * 1.5)
            let fy = sy + 16 + floor(t * 19)
            rect(fx * p, fy * p, p, p, fill: foreground)
            if k % 3 == 0 {
              rect((fx - 1) * p, fy * p, 3 * p, p, fill: alpha(foreground, 0.5))
              rect(fx * p, (fy - 1) * p, p, 3 * p, fill: alpha(foreground, 0.5))
            }
          }
        }
        // Fog: bands of mist sliding past each other.
        if kind == "fog" {
          for k in range(5) {
            let off = floor((tt * (2 + k % 3)) % 12)
            for s in range(5) {
              rect((sx + (s * 12 + (k % 2 == 0 ? off : 12 - off)) % 48 - 4) * p, (sy + 8 + k * 5) * p, 8 * p, p, fill: alpha(foreground, 0.4 - k * 0.05))
            }
          }
        }
        for i in range(24) {
          rect((sx + i * 2) * p, gr * p, p, p, fill: kind == "snow" ? alpha(foreground, 0.6) : alpha(muted, 0.35))
        }
      }

      let tx = ox + 128
      for it in ticker {
        let tw = len(it.t) * 4
        if tw > 46 {
          let off = max(0, floor((tt * 6) % (tw + 18)) - 12)
          clip(tx * p, (oy + it.y) * p, 46 * p, 5 * p) {
            rect(tx * p, (oy + it.y) * p, 46 * p, 5 * p, fill: mix(background, foreground, 0.05))
            for i in range(len(it.t)) {
              sprite(get(font, sub(it.t, i, i + 1), blankGlyph), (tx + i * 4 - off) * p, (oy + it.y) * p, p, color: it.c)
            }
          }
        }
      }
      // The grid as two zig-zag paths (one line per row and column cost ~220 draws a frame).
      path(range(2 * (floor(width / p) + 1)).map(n => [floor(n / 2) * p, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
      path(range(2 * (floor(height / p) + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * p]), stroke: background, width: 0.35)
    }
  }

  screen {
    title: "weather"
    Column {
      scroll: true
      gap: 0
      // Where to look, first: the box searches for a place as it's typed and lists the top matches under it; a
      // tap pins one. Under that, where the forecast is from, and while a place is pinned, a button back to
      // following you.
      Input { text: query; placeholder: place != "" ? "search another place" : "search a place (now following you by network)"; fill: width; onChange: { query = value; searchAt = wakeClock + 2 }; onSubmit: { query = value; refresh() } }
      Spacer { height: 10 }
      if trim(query) != "" {
        Row {
          gap: 0
          Canvas {
            weight: 120
            height: 14 * screenWidth / 160
            let q = width / 120
            let rowsN = floor(height / q)
            let hd = len(picks) > 0 ? "TOP MATCHES, TAP ONE" : found != null && found.ok ? "NO MATCH" : "SEARCHING..."
            rect(0, 0, width, height, fill: alpha(foreground, 0.05))
            for j in range(len(hd)) {
              sprite(get(font, sub(hd, j, j + 1), unknownGlyph), (2 + j * 4) * q, 5 * q, q, color: muted)
            }
            path(range(2 * 121).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
            path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
          }
          Canvas {
            weight: 40
            height: 14 * screenWidth / 160
            onTap: { query = ""; refresh() }
            let q = width / 40
            let rowsN = floor(height / q)
            let t = "CLOSE"
            rect(0, 0, width, height, fill: alpha(foreground, 0.05))
            rect(6 * q, 2 * q, 30 * q, 10 * q, fill: alpha(muted, 0.18))
            for j in range(len(t)) {
              sprite(get(font, sub(t, j, j + 1), unknownGlyph), (11 + j * 4) * q, 5 * q, q, color: foreground)
            }
            path(range(2 * 41).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
            path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
          }
        }
        for h in picks key h.label {
          Canvas {
            fill: width
            height: 14 * screenWidth / 160
            onTap: { place = "${h.lat},${h.lon}"; placeName = h.name; query = "" }
            let q = width / 160
            let rowsN = floor(height / q)
            let t = upper(h.label)
            rect(0, 0, width, height, fill: alpha(foreground, 0.05))
            for j in range(min(len(t), 39)) {
              sprite(get(font, sub(t, j, j + 1), unknownGlyph), (2 + j * 4) * q, 5 * q, q, color: j < len(h.name) ? foreground : muted)
            }
            path(range(2 * 161).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
            path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
          }
        }
        if found != null && found.ok && len(picks) == 0 {
          Canvas {
            fill: width
            height: 14 * screenWidth / 160
            let q = width / 160
            let rowsN = floor(height / q)
            let t = "CHECK THE SPELLING, OR A NEARBY TOWN"
            rect(0, 0, width, height, fill: alpha(foreground, 0.05))
            for j in range(len(t)) {
              sprite(get(font, sub(t, j, j + 1), unknownGlyph), (2 + j * 4) * q, 5 * q, q, color: foreground)
            }
            path(range(2 * 161).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
            path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
          }
        }
        Spacer { height: 10 }
      }
      Row {
        gap: 0
        Canvas {
          weight: 110
          height: 16 * screenWidth / 160
          let q = width / 110
          let rowsN = floor(height / q)
          rect(0, 0, width, height, fill: alpha(foreground, 0.05))
          for j in range(min(len(viaText), 26)) {
            sprite(get(font, sub(viaText, j, j + 1), unknownGlyph), (2 + j * 4) * q, 6 * q, q, color: muted)
          }
          path(range(2 * 111).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
          path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
        }
        if place != "" {
          Canvas {
            weight: 50
            height: 16 * screenWidth / 160
            onTap: place = ""
            let q = width / 50
            let rowsN = floor(height / q)
            let t = "FOLLOW ME"
            rect(0, 0, width, height, fill: alpha(foreground, 0.05))
            rect(4 * q, 3 * q, 44 * q, 11 * q, fill: alpha(muted, 0.18))
            for j in range(len(t)) {
              sprite(get(font, sub(t, j, j + 1), unknownGlyph), (8 + j * 4) * q, 6 * q, q, color: foreground)
            }
            path(range(2 * 51).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
            path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
          }
        } else {
          Canvas {
            weight: 50
            height: 16 * screenWidth / 160
            let q = width / 50
            let rowsN = floor(height / q)
            rect(0, 0, width, height, fill: alpha(foreground, 0.05))
            path(range(2 * 51).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
            path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
          }
        }
      }
      // Now: the tile's scene at twice the size (each of its pixels is 2x2 cells of the grid), and beside it
      // the conditions, temperature, feels-like, high and low, and where.
      Canvas {
        onTap: wakeAt = wakeClock
        fill: width
        height: 80 * screenWidth / 160
        let q = width / 160
        let tt = animOn ? time : 6
        let p = 2 * q
        let rowsN = floor(height / q)
        rect(0, 0, width, height, fill: alpha(foreground, 0.05))
        let sx = 1
        let sy = 1
        let gr = sy + 36
        let bright = kind == "partly" || kind == "cloudy" || kind == "fog"
        let cFill = bright ? mix(foreground, background, dark ? 0.4 : 0.12) : mix(foreground, background, 0.48)
        let cShade = bright ? mix(foreground, background, dark ? 0.62 : 0.42) : mix(foreground, background, 0.7)
        let cTop = bright ? foreground : mix(foreground, background, 0.3)
        let flash = kind == "storm" && (tt % 4.2 < 0.12 || (tt % 4.2 > 0.22 && tt % 4.2 < 0.3))
        clip(sx * p, sy * p, 48 * p, 38 * p) {
          if flash {
            rect(sx * p, sy * p, 48 * p, 38 * p, fill: alpha(foreground, 0.14))
          }
          // What of the sky shows through: all of it when clear or partly cloudy, the sun's disc through fog.
          let skyOpen = kind == "clear" || kind == "partly"
          let veil = kind == "fog" ? 0.35 : 1
          // Twilight: the horizon glows while the sun is just under or over it.
          let dusk = clamp(1 - abs(sunAlt + 1) / 8, 0, 1)
          if skyOpen && dusk > 0 {
            for k in range(8) {
              rect(sx * p, (gr - 1 - k) * p, 48 * p, p, fill: alpha(orange, dusk * (0.3 - k * 0.035)))
            }
          }
          // Stars fade in through twilight.
          if skyOpen && sunAlt < -2 {
            for k in range(7) {
              rect((sx + starX[k]) * p, (sy + starY[k]) * p, p, p, fill: alpha(foreground, clamp((-sunAlt - 2) / 8, 0, 1) * (0.2 + 0.6 * abs(sin(tt * 1.3 + k * 2.1)))))
            }
          }
          // The moon and the sun where they are, cut off by the horizon (paler by day, for the moon).
          clip(sx * p, sy * p, 48 * p, (gr - sy) * p) {
            if (skyOpen || kind == "fog") && moonAlt > -4 && dark {
              let mx = sx + round(moonXY.x)
              let my = sy + moonXY.y
              sprite(moonNow, (mx - 6) * p, (my - 6) * p, p, palette: {l: alpha(mix(yellow, foreground, 0.55), veil), d: alpha(foreground, veil * 0.12)})
            }
            if (skyOpen || kind == "fog") && sunAlt > -4 {
              let bx = sx + round(sunXY.x)
              let by = sy + sunXY.y
              if skyOpen {
                for k in range(8) {
                  let a = rad(k * 45 + tt * 25)
                  for rr in range(2 + (k + floor(tt * 2)) % 2) {
                    rect(round(bx + cos(a) * (8 + rr)) * p, round(by + sin(a) * (8 + rr)) * p, p, p, fill: alpha(yellow, 0.9 - rr * 0.3))
                  }
                }
              }
              sprite(sunArt, (bx - 6) * p, (by - 6) * p, p, palette: {b: alpha(yellow, veil), s: alpha(orange, veil), h: alpha(mix(yellow, foreground, 0.6), veil)})
            }
          }
          // Clouds: one drifting across the sun, or a slow sky of them.
          if kind == "partly" {
            sprite(cloudBig, (sx + 20 + round(sin(tt * 0.35) * 5)) * p, (sy + 15) * p, p, palette: {b: cFill, s: cShade, h: cTop})
          }
          if kind == "cloudy" || kind == "rain" || kind == "snow" || kind == "storm" {
            sprite(cloudSmall, (sx - 16 + floor((tt * 2.2) % 64)) * p, (sy + 2) * p, p, palette: {b: cShade, s: mix(cShade, background, 0.4), h: cFill})
            sprite(cloudBig, (sx + 12 + round(sin(tt * 0.4) * (kind == "cloudy" ? 4 : 2))) * p, (sy + 6) * p, p, palette: {b: cFill, s: cShade, h: cTop})
          }
          if kind == "cloudy" {
            sprite(cloudSmall, (sx + 47 - floor((tt * 3.1 + 20) % 64)) * p, (sy + 18) * p, p, palette: {b: cFill, s: cShade, h: cTop})
          }
          // Rain falls from the cloud and splashes on the ground; storms add lightning.
          if kind == "rain" || kind == "storm" {
            for k in range(9) {
              let dx = sx + 14 + (k * 5) % 22
              let t = (tt * 1.6 + k * 0.37) % 1
              let dy = sy + 16 + floor(t * 20)
              if dy < gr - 1 {
                rect(dx * p, dy * p, p, 2 * p, fill: alpha(cyan, 0.85))
              }
              if t > 0.93 {
                rect((dx - 1) * p, (gr - 1) * p, p, p, fill: alpha(cyan, 0.6))
                rect((dx + 1) * p, (gr - 1) * p, p, p, fill: alpha(cyan, 0.6))
              }
            }
          }
          if flash {
            sprite(boltArt, (sx + 20) * p, (sy + 15) * p, 2 * p, palette: {y: yellow})
          }
          // Snow drifts down, swaying.
          if kind == "snow" {
            for k in range(10) {
              let t = (tt * 0.35 + k * 0.29) % 1
              let fx = sx + 13 + snowX[k] + round(sin(tt * 2 + k) * 1.5)
              let fy = sy + 16 + floor(t * 19)
              rect(fx * p, fy * p, p, p, fill: foreground)
              if k % 3 == 0 {
                rect((fx - 1) * p, fy * p, 3 * p, p, fill: alpha(foreground, 0.5))
                rect(fx * p, (fy - 1) * p, p, 3 * p, fill: alpha(foreground, 0.5))
              }
            }
          }
          // Fog: bands of mist sliding past each other.
          if kind == "fog" {
            for k in range(5) {
              let off = floor((tt * (2 + k % 3)) % 12)
              for s in range(5) {
                rect((sx + (s * 12 + (k % 2 == 0 ? off : 12 - off)) % 48 - 4) * p, (sy + 8 + k * 5) * p, 8 * p, p, fill: alpha(foreground, 0.4 - k * 0.05))
              }
            }
          }
          for i in range(24) {
            rect((sx + i * 2) * p, gr * p, p, p, fill: kind == "snow" ? alpha(foreground, 0.6) : alpha(muted, 0.35))
          }
        }

        let rx = 102
        let rows1 = [sub(wxDesc, 0, min(len(wxDesc), 14)), len(wxDesc) > 14 ? sub(wxDesc, 14, min(len(wxDesc), 28)) : ""]
        for r in range(2) {
          for j in range(len(rows1[r])) {
            sprite(get(font, sub(rows1[r], j, j + 1), unknownGlyph), (rx + j * 4) * q, (4 + r * 7) * q, q, color: foreground)
          }
        }
        let bigK = len(tStr) > 3 ? 3 : 4
        for j in range(len(tStr)) {
          sprite(get(font, sub(tStr, j, j + 1), unknownGlyph), (rx + j * 4 * bigK) * q, 20 * q, bigK * q, color: tColor)
        }
        if cur != null {
          let feels = "FEELS ${get(cur, "FeelsLike" + unit)}°"
          let hl = "↑${get(day, "maxtemp" + unit)}° ↓${get(day, "mintemp" + unit)}°"
          for j in range(len(feels)) {
            sprite(get(font, sub(feels, j, j + 1), unknownGlyph), (rx + j * 4) * q, 44 * q, q, color: muted)
          }
          for j in range(len(hl)) {
            let ch = sub(hl, j, j + 1)
            sprite(get(font, ch, unknownGlyph), (rx + j * 4) * q, 52 * q, q, color: ch == "↑" ? orange : ch == "↓" ? cyan : foreground)
          }
          let where = [upper(town ?? ""), upper(area.country[0].value ?? "")].map(t => sub(t, 0, min(len(t), 14)))
          for r in range(2) {
            for j in range(len(where[r])) {
              sprite(get(font, sub(where[r], j, j + 1), unknownGlyph), (rx + j * 4) * q, (62 + r * 7) * q, q, color: r == 0 ? foreground : muted)
            }
          }
        }
        path(range(2 * 161).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
        path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
      }
      // Conditions: six tiles; tapping one opens its hourly chart below (and tapping it again closes it).
      Canvas {
        fill: width
        height: 10 * screenWidth / 160
        let q = width / 160
        let rowsN = floor(height / q)
        let hd = "CONDITIONS"
        let hint = hourly == null ? "" : "TAP FOR HOURLY"
        rect(0, 0, width, height, fill: alpha(foreground, 0.05))
        for j in range(len(hd)) {
          sprite(get(font, sub(hd, j, j + 1), unknownGlyph), (2 + j * 4 * 1) * q, (3) * q, 1 * q, color: accent)
        }
        rect((4 + len(hd) * 4) * q, 5 * q, (152 - len(hd) * 4 - len(hint) * 4) * q, q, fill: alpha(muted, 0.35))
        for j in range(len(hint)) {
          sprite(get(font, sub(hint, j, j + 1), unknownGlyph), (158 - len(hint) * 4 + j * 4 * 1) * q, (3) * q, 1 * q, color: muted)
        }
        path(range(2 * (160 + 1)).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
        path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
      }
      if len(wxCond) == 6 {
        for r in range(3) {
          Row {
            gap: 0
            for c in range(2) {
              Canvas {
                weight: 80
                height: 22 * screenWidth / 160
                onTap: { wakeAt = wakeClock; detail = detail == wxCond[r * 2 + c].m || hourly == null ? "" : wxCond[r * 2 + c].m; openedAt = time }
                let q = width / 80
                let rowsN = floor(height / q)
                let it = wxCond[r * 2 + c]
                let sel = detail == it.m
                let lab = sub(it.l, 0, min(len(it.l), 17))
                let val = sub(it.v, 0, min(len(it.v), 9))
                let chev = hourly == null ? "" : sel ? "↓" : ">"
                rect(0, 0, width, height, fill: sel ? alpha(accent, 0.14) : alpha(foreground, 0.05))
                for j in range(len(lab)) {
                  sprite(get(font, sub(lab, j, j + 1), unknownGlyph), (2 + j * 4) * q, 4 * q, q, color: sel ? accent : muted)
                }
                for j in range(len(chev)) {
                  sprite(get(font, chev, unknownGlyph), 74 * q, 4 * q, q, color: sel ? accent : alpha(muted, 0.6))
                }
                for j in range(len(val)) {
                  sprite(get(font, sub(val, j, j + 1), unknownGlyph), (2 + j * 8) * q, 11 * q, 2 * q, color: it.c)
                }
                path(range(2 * (80 + 1)).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
                path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
              }
            }
          }
        }
      }
      // The opened tile's hourly chart: twelve hours in view (tap the left or right third to move six), animated
      // as it opens (bars grow, arrows spin in, the line draws itself) and alive while it stays open.
      if detail != "" && hourly != null {
        Canvas {
          fill: width
          height: 74 * screenWidth / 160
          onTap: { wakeAt = wakeClock; hScroll = clamp(hScroll + (x < screenWidth / 3 ? -6 : x > screenWidth * 2 / 3 ? 6 : 0), 0, lastOffs) }
          let q = width / 160
        let tt = animOn ? time : openedAt + 30
          let rowsN = floor(height / q)
          let offs = clamp(floor(hScroll), 0, lastOffs)
          let u = tt < openedAt ? 1 : clamp((tt - openedAt) / 0.7, 0, 1)
          let info = get(detailInfo, detail, {t: "", s: ""})
          let win = hourly.drop(offs).take(12)
          let hint = "< TAP THE SIDES OR DRAG BELOW >"
          rect(0, 0, width, height, fill: alpha(accent, 0.06))
          for j in range(len(info.t)) {
            sprite(get(font, sub(info.t, j, j + 1), unknownGlyph), (2 + j * 4 * 1) * q, (3) * q, 1 * q, color: accent)
          }
          for j in range(len(info.s)) {
            sprite(get(font, sub(info.s, j, j + 1), unknownGlyph), (2 + j * 4 * 1) * q, (11) * q, 1 * q, color: muted)
          }

          if detail == "uv" {
            let top = max(11, max(win.map(h => h.uv)))
            for i in range(len(win)) {
              let h = win[i]
              let ui = clamp(u * 1.8 - i * 0.07, 0, 1)
              let bh = round(h.uv / top * 34 * ui)
              let lab = "${round(h.uv)}"
              rect((5 + i * 13) * q, (58 - bh) * q, 7 * q, bh * q, fill: h.uv < 3 ? green : h.uv < 6 ? yellow : h.uv < 8 ? orange : h.uv < 11 ? red : magenta)
              for j in range(len(lab)) {
                sprite(get(font, sub(lab, j, j + 1), unknownGlyph), (8 + i * 13 - len(lab) * 2 + j * 4) * q, (51 - bh) * q, q, color: foreground)
              }
            }
            // The sun beside the title, its rays flickering.
            sprite(icons.clear, 149 * q, 3 * q, q, palette: {y: alpha(yellow, 0.55 + 0.45 * abs(sin(tt * 3)))})
          }
          if detail == "rain" {
            for i in range(len(win)) {
              let h = win[i]
              let ui = clamp(u * 1.8 - i * 0.07, 0, 1)
              let bh = round(h.pop / 100 * 34 * ui)
              let lab = "${h.pop}"
              rect((5 + i * 13) * q, (58 - bh) * q, 7 * q, max(bh, 1) * q, fill: h.pop >= 30 ? cyan : alpha(cyan, 0.45))
              for j in range(len(lab)) {
                sprite(get(font, sub(lab, j, j + 1), unknownGlyph), (8 + i * 13 - len(lab) * 2 + j * 4) * q, (51 - bh) * q, q, color: h.pop >= 30 ? foreground : muted)
              }
              // Where rain is likely, drops fall into the bar.
              if h.pop >= 30 && u >= 1 {
                for k in range(2) {
                  let t = (tt * 1.3 + i * 0.37 + k * 0.5) % 1
                  rect((6 + i * 13 + k * 4) * q, (20 + round(t * (30 - bh))) * q, q, 2 * q, fill: alpha(cyan, 0.8))
                }
              }
            }
          }
          if detail == "humidity" {
            for i in range(len(win)) {
              let h = win[i]
              let ui = clamp(u * 1.8 - i * 0.07, 0, 1)
              let fh = round(h.rh / 100 * 34 * ui)
              let lab = "${h.rh}"
              rect((5 + i * 13) * q, 24 * q, 7 * q, 34 * q, fill: alpha(muted, 0.15))
              rect((5 + i * 13) * q, (58 - fh) * q, 7 * q, fh * q, fill: alpha(blue, 0.85))
              // The surface shimmers.
              if fh > 0 {
                rect((5 + i * 13 + (floor(tt * 4) + i) % 2 * 3) * q, (58 - fh) * q, 4 * q, q, fill: alpha(foreground, 0.35))
              }
              for j in range(len(lab)) {
                sprite(get(font, sub(lab, j, j + 1), unknownGlyph), (8 + i * 13 - len(lab) * 2 + j * 4) * q, 18 * q, q, color: foreground)
              }
            }
          }
          if detail == "wind" {
            for i in range(len(win)) {
              let h = win[i]
              let ui = clamp(u * 1.6 - i * 0.06, 0, 1)
              let k = round(((h.wd + 180) % 360) / 45) % 8
              let ks = (k + floor((1 - ui) * 16)) % 8
              let wk = imperial ? h.ws * 1.609 : h.ws
              let col = wk < 10 ? alpha(foreground, 0.6) : wk < 20 ? cyan : wk < 35 ? yellow : wk < 50 ? orange : red
              let bob = ui < 1 ? 0 : floor(tt * (1 + wk / 12) + i * 0.5) % 2
              let spd = "${h.ws}"
              let gst = "G${h.wg}"
              sprite(arrows[ks], (5 + i * 13 + windDX[k] * bob) * q, (24 + windDY[k] * bob) * q, q, color: col)
              for j in range(len(spd)) {
                sprite(get(font, sub(spd, j, j + 1), unknownGlyph), (8 + i * 13 - len(spd) * 2 + j * 4) * q, 36 * q, q, color: col)
              }
              for j in range(len(gst)) {
                sprite(get(font, sub(gst, j, j + 1), unknownGlyph), (8 + i * 13 - len(gst) * 2 + j * 4) * q, 46 * q, q, color: muted)
              }
            }
          }
          if detail == "pressure" {
            let pmin = min(hourly.map(h => h.p))
            let pmax = max(hourly.map(h => h.p))
            let ys = win.map(h => 56 - round((h.p - pmin) / max(pmax - pmin, 1) * 28))
            let shown = clamp(floor(u * 13), 0, len(win))
            for i in range(shown) {
              if i > 0 {
                line((8 + (i - 1) * 13 + 0.5) * q, (ys[i - 1] + 0.5) * q, (8 + i * 13 + 0.5) * q, (ys[i] + 0.5) * q, stroke: alpha(accent, 0.7), width: q)
              }
              rect((7 + i * 13) * q, (ys[i] - 1) * q, 3 * q, 3 * q, fill: offs + i == 0 ? (floor(tt * 2) % 2 == 0 ? yellow : accent) : accent)
              if (offs + i) % 3 == 0 {
                let lab = imperial ? fixed(win[i].p * 0.02953, 1) : "${round(win[i].p)}"
                for j in range(len(lab)) {
                  sprite(get(font, sub(lab, j, j + 1), unknownGlyph), (8 + i * 13 - len(lab) * 2 + j * 4) * q, (ys[i] - 8) * q, q, color: foreground)
                }
              }
            }
          }
          if detail == "visibility" {
            for i in range(len(win)) {
              let h = win[i]
              let ui = clamp(u * 1.8 - i * 0.07, 0, 1)
              let km = h.vis / 1000
              let bh = round(min(km, 30) / 30 * 34 * ui)
              let lab = "${min(round(imperial ? h.vis / 1609 : km), 99)}"
              rect((5 + i * 13) * q, (58 - bh) * q, 7 * q, max(bh, 1) * q, fill: km < 1 ? red : km < 5 ? orange : km < 10 ? yellow : green)
              for j in range(len(lab)) {
                sprite(get(font, sub(lab, j, j + 1), unknownGlyph), (8 + i * 13 - len(lab) * 2 + j * 4) * q, (51 - bh) * q, q, color: foreground)
              }
              // Mist drifts through the hours where you can see less than 5 km.
              if km < 5 {
                rect((3 + i * 13 + floor(tt * 3 + i) % 6) * q, (30 + i % 3 * 6) * q, 6 * q, q, fill: alpha(foreground, 0.35))
              }
            }
            // As it opens, the mist clears.
            rect(0, 18 * q, width, 42 * q, fill: alpha(foreground, (1 - u) * 0.4))
          }
          // The hours: now, then each hour, with the day at midnight.
          for i in range(len(win)) {
            let hh = fmtTime(win[i].t, "HH")
            let lab = offs + i == 0 ? "NOW" : hh == "00" ? upper(fmtTime(win[i].t, "EEE")) : hh
            for j in range(len(lab)) {
              sprite(get(font, sub(lab, j, j + 1), unknownGlyph), (8 + i * 13 - len(lab) * 2 + j * 4) * q, 62 * q, q, color: offs + i == 0 || hh == "00" ? accent : muted)
            }
          }
          for j in range(len(hint)) {
            sprite(get(font, sub(hint, j, j + 1), unknownGlyph), (80 - len(hint) * 2 + j * 4 * 1) * q, (69) * q, 1 * q, color: alpha(muted, 0.6))
          }
          path(range(2 * (160 + 1)).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
          path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
        }
        // The timeline: drag it to scroll the hours (dragging the chart itself would stop the page scrolling), or tap an hour.
        Canvas {
          fill: width
          height: 12 * screenWidth / 160
          onDrag: hScroll = clamp(hScroll + dx / (screenWidth / 160) / 3, 0, lastOffs)
          onTap: hScroll = clamp(round((x / (screenWidth / 160) - 8) / 3) - 6, 0, lastOffs)
          let q = width / 160
          let rowsN = floor(height / q)
          let offs = clamp(floor(hScroll), 0, lastOffs)
          rect(0, 0, width, height, fill: alpha(foreground, 0.05))
          for i in range(len(hourly)) {
            let h = hourly[i]
            rect((8 + i * 3) * q, 5 * q, 2 * q, 2 * q, fill: fmtTime(h.t, "HH") == "00" ? alpha(accent, 0.8) : h.day ? alpha(foreground, 0.35) : alpha(muted, 0.25))
          }
          rect((7 + offs * 3) * q, 3 * q, 37 * q, q, fill: accent)
          rect((7 + offs * 3) * q, 8 * q, 37 * q, q, fill: accent)
          sprite(get(font, "<", unknownGlyph), 2 * q, 4 * q, q, color: offs > 0 ? accent : alpha(muted, 0.3))
          sprite(get(font, ">", unknownGlyph), 155 * q, 4 * q, q, color: offs < lastOffs ? accent : alpha(muted, 0.3))
          path(range(2 * (160 + 1)).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
          path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
        }
      }
      // Until the hourly forecast arrives: wttr's 3-hour steps.
      if hourly == null {
        // The next 24 hours: the time, an icon (a moon after dark), the temperature riding a little curve, rain.
        Canvas {
          fill: width
          height: 62 * screenWidth / 160
          let q = width / 160
          let rowsN = floor(height / q)
          let hd = "NEXT 24 HOURS"
          rect(0, 0, width, height, fill: alpha(foreground, 0.05))
          for j in range(len(hd)) {
            sprite(get(font, sub(hd, j, j + 1), unknownGlyph), (2 + j * 4) * q, 3 * q, q, color: accent)
          }
          rect((4 + len(hd) * 4) * q, 5 * q, (154 - len(hd) * 4) * q, q, fill: alpha(muted, 0.35))
          for i in range(len(steps)) {
            let s = steps[i]
            let h = ((s.hr % 24) + 24) % 24
            let mid = 2 + i * 20 + 9
            let lab = s.hr <= hourNow && hourNow < s.hr + 3 ? "NOW" : pad(int(h), 2, "0")
            let k = get(kindOf, s.code, "rain")
            let ik = (k == "clear" || k == "partly") && (h < riseH || h >= setH) ? k + "N" : k
            let tt = "${s.t}°"
            let rn = "${s.rain}%"
            for j in range(len(lab)) {
              sprite(get(font, sub(lab, j, j + 1), unknownGlyph), (mid - len(lab) * 2 + j * 4) * q, 12 * q, q, color: lab == "NOW" ? accent : muted)
            }
            sprite(get(icons, ik, icons.cloudy), (mid - 7) * q, 20 * q, 2 * q, palette: iconPal)
            for j in range(len(tt)) {
              sprite(get(font, sub(tt, j, j + 1), unknownGlyph), (mid - len(tt) * 2 + j * 4) * q, (37 + round((tHi - s.t) / max(tHi - tLo, 1) * 6)) * q, q, color: foreground)
            }
            for j in range(len(rn)) {
              sprite(get(font, sub(rn, j, j + 1), unknownGlyph), (mid - len(rn) * 2 + j * 4) * q, 51 * q, q, color: s.rain >= 30 ? cyan : muted)
            }
          }
          path(range(2 * 161).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
          path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
        }
      }
      // The next 48 hours, hour by hour: the time, an icon (a moon after dark), the temperature on a little curve,
      // and the chance of rain. Twelve hours in view; tap the sides or drag the timeline. wttr's 3-hour steps
      // stand in until the hourly forecast arrives.
      if hourly != null {
        Canvas {
          fill: width
          height: 62 * screenWidth / 160
          onTap: hScroll = clamp(hScroll + (x < screenWidth / 3 ? -6 : x > screenWidth * 2 / 3 ? 6 : 0), 0, lastOffs)
          let q = width / 160
          let rowsN = floor(height / q)
          let offs = clamp(floor(hScroll), 0, lastOffs)
          let win = hourly.drop(offs).take(12)
          let wLo = min(win.map(h => h.temp))
          let wHi = max(win.map(h => h.temp))
          let hd = "NEXT 48 HOURS"
          rect(0, 0, width, height, fill: alpha(foreground, 0.05))
          for j in range(len(hd)) {
            sprite(get(font, sub(hd, j, j + 1), unknownGlyph), (2 + j * 4 * 1) * q, (3) * q, 1 * q, color: accent)
          }
          rect((4 + len(hd) * 4) * q, 5 * q, (154 - len(hd) * 4) * q, q, fill: alpha(muted, 0.35))
          for i in range(len(win)) {
            let h = win[i]
            let hh = fmtTime(h.t, "HH")
            let lab = offs + i == 0 ? "NOW" : hh == "00" ? upper(fmtTime(h.t, "EEE")) : hh
            let k = get(kindOf, h.code, "rain")
            let ik = (k == "clear" || k == "partly") && !h.day ? k + "N" : k
            let tt = "${h.temp}"
            let rn = "${h.pop}"
            for j in range(len(lab)) {
              sprite(get(font, sub(lab, j, j + 1), unknownGlyph), (8 + i * 13 - len(lab) * 2 + j * 4) * q, 12 * q, q, color: offs + i == 0 || hh == "00" ? accent : muted)
            }
            sprite(get(icons, ik, icons.cloudy), (5 + i * 13) * q, 20 * q, q, palette: iconPal)
            for j in range(len(tt)) {
              sprite(get(font, sub(tt, j, j + 1), unknownGlyph), (8 + i * 13 - len(tt) * 2 + j * 4) * q, (31 + round((wHi - h.temp) / max(wHi - wLo, 1) * 8)) * q, q, color: foreground)
            }
            for j in range(len(rn)) {
              sprite(get(font, sub(rn, j, j + 1), unknownGlyph), (8 + i * 13 - len(rn) * 2 + j * 4) * q, 47 * q, q, color: h.pop >= 30 ? cyan : alpha(muted, 0.8))
            }
          }
          let rl = "RAIN %"
          for j in range(len(rl)) {
            sprite(get(font, sub(rl, j, j + 1), unknownGlyph), (2 + j * 4 * 1) * q, (55) * q, 1 * q, color: alpha(muted, 0.6))
          }
          path(range(2 * (160 + 1)).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
          path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
        }
        // The timeline: drag it to scroll the hours (dragging the chart itself would stop the page scrolling), or tap an hour.
        Canvas {
          fill: width
          height: 12 * screenWidth / 160
          onDrag: hScroll = clamp(hScroll + dx / (screenWidth / 160) / 3, 0, lastOffs)
          onTap: hScroll = clamp(round((x / (screenWidth / 160) - 8) / 3) - 6, 0, lastOffs)
          let q = width / 160
          let rowsN = floor(height / q)
          let offs = clamp(floor(hScroll), 0, lastOffs)
          rect(0, 0, width, height, fill: alpha(foreground, 0.05))
          for i in range(len(hourly)) {
            let h = hourly[i]
            rect((8 + i * 3) * q, 5 * q, 2 * q, 2 * q, fill: fmtTime(h.t, "HH") == "00" ? alpha(accent, 0.8) : h.day ? alpha(foreground, 0.35) : alpha(muted, 0.25))
          }
          rect((7 + offs * 3) * q, 3 * q, 37 * q, q, fill: accent)
          rect((7 + offs * 3) * q, 8 * q, 37 * q, q, fill: accent)
          sprite(get(font, "<", unknownGlyph), 2 * q, 4 * q, q, color: offs > 0 ? accent : alpha(muted, 0.3))
          sprite(get(font, ">", unknownGlyph), 155 * q, 4 * q, q, color: offs < lastOffs ? accent : alpha(muted, 0.3))
          path(range(2 * (160 + 1)).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
          path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
        }
      }
      // Five days (three if Open-Meteo is down): icon, rain chance, and the low to high on one shared scale.
      Canvas {
        fill: width
        height: (14 + len(forecast) * 10) * screenWidth / 160
        let q = width / 160
        let rowsN = floor(height / q)
        let hd = "${len(forecast)} DAYS"
        let span = max(highest - lowest, 1)
        rect(0, 0, width, height, fill: alpha(foreground, 0.05))
        for j in range(len(hd)) {
          sprite(get(font, sub(hd, j, j + 1), unknownGlyph), (2 + j * 4) * q, 3 * q, q, color: accent)
        }
        rect((4 + len(hd) * 4) * q, 5 * q, (154 - len(hd) * 4) * q, q, fill: alpha(muted, 0.35))
        for i in range(len(forecast)) {
          let d = forecast[i]
          let y = 12 + i * 10
          let dn = i == 0 ? "TODAY" : upper(fmtTime(now + 86400 * i, "EEE"))
          let rn = "${d.rain}%"
          let lo = "${d.lo}°"
          let hi = "${d.hi}°"
          let x0 = 72 + round((d.lo - lowest) / span * 66)
          let x1 = 72 + round((d.hi - lowest) / span * 66)
          for j in range(len(dn)) {
            sprite(get(font, sub(dn, j, j + 1), unknownGlyph), (2 + j * 4) * q, y * q, q, color: i == 0 ? accent : foreground)
          }
          sprite(get(icons, get(kindOf, d.code, "rain"), icons.cloudy), 24 * q, (y - 1) * q, q, palette: iconPal)
          for j in range(len(rn)) {
            sprite(get(font, sub(rn, j, j + 1), unknownGlyph), (34 + j * 4) * q, y * q, q, color: d.rain >= 30 ? cyan : muted)
          }
          for j in range(len(lo)) {
            sprite(get(font, sub(lo, j, j + 1), unknownGlyph), (68 - len(lo) * 4 + j * 4) * q, y * q, q, color: muted)
          }
          rect(72 * q, (y + 1) * q, 68 * q, 3 * q, fill: alpha(muted, 0.18))
          rect(x0 * q, (y + 1) * q, max(x1 - x0 + 2, 3) * q, 3 * q, fill: linear(72 * q, 0, 140 * q, 0, [cyan, green, orange]))
          for j in range(len(hi)) {
            sprite(get(font, sub(hi, j, j + 1), unknownGlyph), (144 + j * 4) * q, y * q, q, color: foreground)
          }
        }
        path(range(2 * 161).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
        path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
      }
      // Sun and moon: a golden-hour scene (dawn over the hills before solar noon, dusk on the Atlantic after) with
      // today's sunrise, sunset and golden hour; and the moon as it is tonight, with Pierrot keeping it company.
      Canvas {
        fill: width
        height: 10 * screenWidth / 160
        let q = width / 160
        let rowsN = floor(height / q)
        let hd = "SUN & MOON"
        rect(0, 0, width, height, fill: alpha(foreground, 0.05))
        for j in range(len(hd)) {
          sprite(get(font, sub(hd, j, j + 1), unknownGlyph), (2 + j * 4) * q, (3) * q, q, color: accent)
        }
        rect((4 + len(hd) * 4) * q, 5 * q, (154 - len(hd) * 4) * q, q, fill: alpha(muted, 0.35))
        path(range(2 * 161).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
        path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
      }
      Box {
        fill: width
        // The still layer: the panel and the times under the scene.
        Canvas {
          fill: width
          height: 64 * screenWidth / 160
          let q = width / 160
          let rowsN = floor(height / q)
          let hz = 30
          rect(0, 0, width, height, fill: alpha(foreground, 0.05))
          // Under the scene: sunrise and sunset, golden hour, the length of the day.
          let riseT = riseTs == null ? "--:--" : fmtTime(riseTs, "HH:mm")
          let setT = setTs == null ? "--:--" : fmtTime(setTs, "HH:mm")
          let rs = "↑ ${riseT}  ↓ ${setT}"
          let gold = isDawn ? (goldenMornTs == null ? "" : "GOLDEN TILL ${fmtTime(goldenMornTs, "HH:mm")}") : (goldenEveTs == null ? "" : "GOLDEN FROM ${fmtTime(goldenEveTs, "HH:mm")}")
          let dl = riseTs == null ? "" : upper(fmtDuration(setTs - riseTs)) + " OF DAY"
          for j in range(len(rs)) {
            let ch = sub(rs, j, j + 1)
            sprite(get(font, ch, unknownGlyph), (3 + j * 4) * q, 50 * q, q, color: ch == "↑" ? orange : ch == "↓" ? cyan : foreground)
          }
          for j in range(len(gold)) {
            sprite(get(font, sub(gold, j, j + 1), unknownGlyph), (3 + j * 4) * q, (57) * q, q, color: yellow)
          }
          for j in range(len(dl)) {
            sprite(get(font, sub(dl, j, j + 1), unknownGlyph), (157 - len(dl) * 4 + j * 4) * q, (50) * q, q, color: muted)
          }
        }
        // The moving layer: the sky, the sun, the hills or the sea, birds; the grid on top.
        Canvas {
          fill: width
          height: 64 * screenWidth / 160
          onTap: wakeAt = wakeClock
          let q = width / 160
          let tt = animOn ? time : 3
          let rowsN = floor(height / q)
          let hz = 30
          // Golden-hour sky, top to horizon: dusk burns from violet to gold, dawn blushes from blue to pale gold.
          let sky = isDawn ? [mix(background, blue, 0.45), mix(blue, magenta, 0.45), mix(magenta, orange, 0.35), mix(orange, foreground, 0.3), mix(yellow, foreground, 0.45)] : [mix(background, magenta, 0.35), mix(magenta, red, 0.5), mix(red, orange, 0.55), orange, mix(orange, yellow, 0.6)]
          let sxc = isDawn ? 104 : 80
          // At dawn it climbs out from behind the hills; at dusk it sits on the sea.
          let syc = (isDawn ? hz - 9 : hz + 1) + round(sin(tt * 0.5) * 2)
          let glow = 0.12 + 0.06 * sin(tt * 2)
          for b in range(5) {
            rect(0, b * 6 * q, 160 * q, 6 * q, fill: sky[b])
          }
          // Softened seams between the bands: two blended rows each (a checkerboard cost 640 draws a frame).
          for b in range(4) {
            rect(0, (b * 6 + 5) * q, 160 * q, q, fill: mix(sky[b], sky[b + 1], 0.35))
            rect(0, (b * 6 + 6) * q, 160 * q, q, fill: mix(sky[b], sky[b + 1], 0.65))
          }
          // The sun, breathing on the horizon inside a pulsing halo, lighter at its top.
          clip(0, 0, 160 * q, hz * q) {
            for r in [14, 11] {
              for dy in range(-r, r + 1) {
                let w = floor(sqrt(r * r - dy * dy))
                rect((sxc - w) * q, (syc + dy) * q, (2 * w + 1) * q, q, fill: alpha(yellow, glow * (r == 14 ? 0.6 : 1)))
              }
            }
            for dy in range(-8, 9) {
              let w = floor(sqrt(64 - dy * dy))
              rect((sxc - w) * q, (syc + dy) * q, (2 * w + 1) * q, q, fill: dy < -4 ? mix(yellow, foreground, isDawn ? 0.15 : 0.45) : dy < 1 ? yellow : mix(yellow, orange, 0.6))
            }
          }
          if isDawn {
            // Hills, far and near, the sun coming up behind them; morning mist drifting across.
            sprite(hillRows, 0, 23 * q, q, palette: {f: mix(sky[1], background, 0.45), n: mix(background, sky[0], 0.25)})
            for k in range(3) {
              rect(((tt * (2 + k) + k * 60) % 190 - 30) * q, (hz - 1 + k * 4) * q, 30 * q, q, fill: alpha(foreground, 0.16))
            }
          } else {
            // The Atlantic: bands deepening toward the shore, the sun's golden path shimmering, sparkles winking.
            for k in range(16) {
              rect(0, (hz + k) * q, 160 * q, q, fill: mix(sky[2], background, 0.5 + k * 0.03))
            }
            for k in range(16) {
              let w = max(12 - floor(k * 0.6), 4)
              let off = round(sin(tt * 2.2 + k * 1.3) * 2)
              rect((sxc - w + off) * q, (hz + k) * q, round(w * 0.9) * q, q, fill: alpha(k % 2 == 0 ? yellow : orange, 0.85 - k * 0.04))
              rect((sxc + 2 - off) * q, (hz + k) * q, round(w * 0.6) * q, q, fill: alpha(yellow, 0.6 - k * 0.03))
            }
            for s in range(6) {
              if (floor(tt * 3) + s) % 4 == 0 {
                rect((sxc - 15 + (s * 13) % 30) * q, (hz + 2 + s * 2) * q, q, q, fill: foreground)
              }
            }
            sprite(scenery.palm, 2 * q, (hz - 13) * q, q, palette: {p: mix(background, sky[0], 0.15)})
          }
          // Two birds crossing, flapping.
          for k in range(2) {
            sprite((floor(tt * 4) + k) % 2 == 0 ? scenery.bird : scenery.bird2, (158 - (tt * 5 + k * 77) % 180) * q, (6 + k * 5 + round(sin(tt * 2 + k))) * q, q, palette: {p: alpha(background, 0.8)})
          }
          path(range(2 * 161).map(n => [floor(n / 2) * q, (floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : height]), stroke: background, width: 0.35)
          path(range(2 * (rowsN + 1)).map(n => [(floor(n / 2) % 2 == 0) == (n % 2 == 0) ? 0 : width, floor(n / 2) * q]), stroke: background, width: 0.35)
        }
      }
      // The moon as it is tonight, over the Paris rooftops, and Pierrot keeping it company: what he gets up to
      // follows its phase. Under it: the phase, how much is lit, and the next full moon.
      Box {
        fill: width
        // The still layer, drawn once: sky, the moon (unless it rocks), its glow when full, the city, the text.
        Canvas {
          fill: width
          height: 82 * screenWidth / 160
          let q = width / 160
          let skyB = [mix(background, blue, 0.08), mix(background, blue, 0.12), mix(background, blue, 0.16), mix(background, blue, 0.2)]
          rect(0, 0, width, height, fill: alpha(foreground, 0.05))
          for b in range(4) {
            rect(0, b * 14 * q, width, (b < 3 ? 14 : 30) * q, fill: skyB[b])
          }
          let mp = get(moonPos, pose, [116, 47])
          if pose == "serenade" {
            for gr in [[25, 0.05], [22, 0.08]] {
              for dy in range(-gr[0], gr[0] + 1) {
                let hw = floor(sqrt(gr[0] * gr[0] - dy * dy))
                rect((mp[0] - hw) * q, (mp[1] + dy) * q, (2 * hw + 1) * q, q, fill: alpha(yellow, gr[1]))
              }
            }
          }
          if pose != "sleep" {
            sprite(moonBig, (mp[0] - 19) * q, (mp[1] - 19) * q, q, palette: {l: mix(yellow, foreground, 0.6), m: mix(mix(yellow, foreground, 0.6), background, 0.12), d: alpha(foreground, 0.1)})
          }
          sprite(tower, 22 * q, (60 - len(tower)) * q, q, palette: {h: mix(background, blue, 0.3)})
          sprite(roofRows, 0, 56 * q, q, palette: {b: mix(background, blue, 0.26), e: mix(background, blue, 0.42), c: mix(background, blue, 0.34)})
          for w in roofWins {
            if w[2] < 3 {
              rect(w[0] * q, (56 + w[1]) * q, q, 2 * q, fill: w[2] == 1 ? mix(orange, foreground, 0.3) : mix(yellow, foreground, 0.25))
            }
          }
          // Under the stage: the phase, how much of it is lit, and when it's next full.
          let mt1 = phaseName
          let mt2 = "${moonLit}% LIT" + (fullTs == null ? "" : upper(" · full ${fmtTime(fullTs, "MMM d")}"))
          for j in range(len(mt1)) {
            sprite(get(font, sub(mt1, j, j + 1), unknownGlyph), (3 + j * 4) * q, (75) * q, q, color: foreground)
          }
          for j in range(len(mt2)) {
            sprite(get(font, sub(mt2, j, j + 1), unknownGlyph), (157 - len(mt2) * 4 + j * 4) * q, (75) * q, q, color: muted)
          }
        }
        // The moving layer: twinkling stars, windows going on and off, the moon when it rocks or blushes, Pierrot, the grid.
        Canvas {
          fill: width
          height: 82 * screenWidth / 160
          onTap: wakeAt = wakeClock
          let q = width / 160
          let rowsN = floor(height / q)
          let tt = animOn ? time : get(restT, pose, 1)
          for n in range(len(stageStars)) {
            rect(stageStars[n][0] * q, stageStars[n][1] * q, q, q, fill: alpha(foreground, 0.25 + 0.6 * abs(sin(tt * 1.1 + n * 1.7))))
          }
          let mp = get(moonPos, pose, [116, 47])
          let mx = mp[0]
          let my = mp[1] + (pose == "sleep" ? floor(sin(tt * 0.8) + 0.5) : 0)
          if pose == "sleep" {
            clip(0, 0, width, 59 * q) {
              sprite(moonBig, (mx - 19) * q, (my - 19) * q, q, palette: {l: mix(yellow, foreground, 0.6), m: mix(mix(yellow, foreground, 0.6), background, 0.12), d: alpha(foreground, 0.1)})
            }
          }
          let serT = tt % 12
          if pose == "serenade" && serT >= 10.2 && serT < 11.4 {
            for dy in range(-19, 20) {
              let hw = floor(sqrt(380.25 - dy * dy))
              rect((mx - hw) * q, (my + dy) * q, (2 * hw + 1) * q, q, fill: alpha(red, 0.3))
            }
          }
          for w in roofWins {
            if w[2] == 8 && (tt / 7 + w[0]) % 3 < 1.6 {
              rect(w[0] * q, (56 + w[1]) * q, q, 2 * q, fill: mix(yellow, foreground, 0.25))
            }
          }
          if pose == "seek" {
            let kT = tt % 16
            let ki = len(seekKeys.filter(k => k.t <= kT)) - 1
            let ka = seekKeys[ki]
            let kb = seekKeys[min(ki + 1, len(seekKeys) - 1)]
            let ff = kb.t == ka.t ? 0 : (kT - ka.t) / (kb.t - ka.t)
            let fe = ff * ff * (3 - 2 * ff)
            let w = lerp(ka.walk, kb.walk, fe)
            let ph = tt * 7
            let thL0 = lerp(ka.thL, kb.thL, fe) + w * 24 * sin(ph)
            let thR0 = lerp(ka.thR, kb.thR, fe) - w * 24 * sin(ph)
            let J = {uaL: lerp(ka.uaL, kb.uaL, fe), faL: lerp(ka.faL, kb.faL, fe), uaR: lerp(ka.uaR, kb.uaR, fe), faR: lerp(ka.faR, kb.faR, fe), thL: thL0, shL: thL0 * 0.4 - w * 10 * max(0, sin(ph)), thR: thR0, shR: thR0 * 0.4 - w * 10 * max(0, 0 - sin(ph))}
            let hx = floor(lerp(ka.hx, kb.hx, fe) + 0.5)
            let hy = 50 - floor(w * abs(sin(ph)) + 0.5)
            let hdx = 0
            let hdy = 0
            let eyesK = contains(["open", "left", "right"], ka.eyes) && tt % 3.3 < 0.12 ? "shut" : ka.eyes
            let mouthK = ka.mouth
            let blushOn = false
            // Pierrot: legs, smock, head and ruff, then the arms in front. Joints are whole cells; sleeves and legs are
            // thick lines between them (an outline pass, then the white).
            let pLegs = [[-1, J.thL, J.shL], [1, J.thR, J.shR]].map(v => {ax: hx + 3 * v[0], ay: hy, a1: v[1], a2: v[2]})
              .map(v => {ax: v.ax, ay: v.ay, bx: v.ax + floor(sin(rad(v.a1)) * 4 + 0.5), by: v.ay + floor(cos(rad(v.a1)) * 4 + 0.5), a2: v.a2})
              .map(v => {s: [[v.ax, v.ay, v.bx, v.by], [v.bx, v.by, v.bx + floor(sin(rad(v.a2)) * 4 + 0.5), v.by + floor(cos(rad(v.a2)) * 4 + 0.5)]]})
            let pArms = [[-1, J.uaL, J.faL], [1, J.uaR, J.faR]].map(v => {ax: hx + 6 * v[0], ay: hy - 10, a1: v[1], a2: v[2]})
              .map(v => {ax: v.ax, ay: v.ay, bx: v.ax + floor(sin(rad(v.a1)) * 5 + 0.5), by: v.ay + floor(cos(rad(v.a1)) * 5 + 0.5), a2: v.a2})
              .map(v => {s: [[v.ax, v.ay, v.bx, v.by], [v.bx, v.by, v.bx + floor(sin(rad(v.a2)) * 5 + 0.5), v.by + floor(cos(rad(v.a2)) * 5 + 0.5)]]})
            for L in pLegs {
              for sg in L.s {
                let n = max(abs(sg[2] - sg[0]), abs(sg[3] - sg[1]), 1)
                for ci in range(n + 1) {
                  let cx = sg[0] + floor((sg[2] - sg[0]) * ci / n + 0.5)
                  let cy = sg[1] + floor((sg[3] - sg[1]) * ci / n + 0.5)
                  rect((cx - 2) * q, (cy - 1) * q, 5 * q, 3 * q, fill: pq.o)
                  rect((cx - 1) * q, (cy - 2) * q, 3 * q, 5 * q, fill: pq.o)
                }
              }
              for sg in L.s {
                let n = max(abs(sg[2] - sg[0]), abs(sg[3] - sg[1]), 1)
                for ci in range(n + 1) {
                  rect((sg[0] + floor((sg[2] - sg[0]) * ci / n + 0.5) - 1) * q, (sg[1] + floor((sg[3] - sg[1]) * ci / n + 0.5) - 1) * q, 3 * q, 3 * q, fill: pq.w)
                }
              }
              let ex = L.s[1][2]
              let ey = L.s[1][3]
              rect((ex - 2) * q, ey * q, 5 * q, 3 * q, fill: pq.o)
              rect((ex - 1) * q, (ey + 1) * q, 3 * q, q, fill: pq.k)
            }
            sprite(pTorso, (hx - 8) * q, (hy - 11) * q, q, palette: pq)
            sprite(pHead, (hx - 6 + hdx) * q, (hy - 25 + hdy) * q, q, palette: pq)
            sprite(get(pEyes, eyesK, pEyes.open), (hx - 4 + hdx) * q, (hy - 19 + hdy) * q, q, palette: pq)
            sprite(get(pMouth, mouthK, pMouth.pout), (hx - 1 + hdx) * q, (hy - 14 + hdy) * q, q, palette: pq)
            rect((hx + 2 + hdx) * q, (hy - 15 + hdy) * q, q, q, fill: pq.t)
            if blushOn {
              rect((hx - 4 + hdx) * q, (hy - 15 + hdy) * q, q, q, fill: pq.c)
              rect((hx + 4 + hdx) * q, (hy - 15 + hdy) * q, q, q, fill: pq.c)
            }
            sprite(pRuff, (hx - 8) * q, (hy - 13) * q, q, palette: pq)
            for L in pArms {
              for sg in L.s {
                let n = max(abs(sg[2] - sg[0]), abs(sg[3] - sg[1]), 1)
                for ci in range(n + 1) {
                  let cx = sg[0] + floor((sg[2] - sg[0]) * ci / n + 0.5)
                  let cy = sg[1] + floor((sg[3] - sg[1]) * ci / n + 0.5)
                  rect((cx - 2) * q, (cy - 1) * q, 5 * q, 3 * q, fill: pq.o)
                  rect((cx - 1) * q, (cy - 2) * q, 3 * q, 5 * q, fill: pq.o)
                }
              }
              for sg in L.s {
                let n = max(abs(sg[2] - sg[0]), abs(sg[3] - sg[1]), 1)
                for ci in range(n + 1) {
                  rect((sg[0] + floor((sg[2] - sg[0]) * ci / n + 0.5) - 1) * q, (sg[1] + floor((sg[3] - sg[1]) * ci / n + 0.5) - 1) * q, 3 * q, 3 * q, fill: pq.w)
                }
              }
              let ex = L.s[1][2]
              let ey = L.s[1][3]
              rect((ex - 2) * q, (ey - 2) * q, 5 * q, 5 * q, fill: pq.o)
              rect((ex - 1) * q, (ey - 1) * q, 3 * q, 3 * q, fill: pq.s)
              rect(ex * q, ey * q, q, q, fill: pq.f)
            }
            // The pole from his right hand, the lantern swinging under its tip, and its flickering glow.
            let hand = [pArms[1].s[1][2], pArms[1].s[1][3]]
            let tipX = hand[0] + floor(sin(rad(178)) * 9 + 0.5)
            let tipY = hand[1] + floor(cos(rad(178)) * 9 + 0.5)
            let rn = max(abs(tipX - hand[0]), abs(tipY - hand[1]), 1)
            for ci in range(rn + 1) {
              rect((hand[0] + floor((tipX - hand[0]) * ci / rn + 0.5)) * q, (hand[1] + floor((tipY - hand[1]) * ci / rn + 0.5)) * q, q, q, fill: mix(orange, background, 0.4))
            }
            let sw = 14 * sin(tt * 3.1) + w * 9 * sin(ph)
            let lx = tipX + floor(sin(rad(sw)) * 3 + 0.5)
            let ly = tipY + floor(cos(rad(sw)) * 3 + 0.5)
            let glow = 0.16 + 0.1 * abs(sin(tt * 9)) + 0.05 * sin(tt * 2.3)
            for r in [6, 4] {
              for dy in range(0 - r, r + 1) {
                let hw = floor(sqrt(r * r - dy * dy))
                rect((lx - hw) * q, (ly + 2 + dy) * q, (2 * hw + 1) * q, q, fill: alpha(yellow, glow * (r == 6 ? 0.6 : 1)))
              }
            }
            rect(lx * q, ly * q, q, q, fill: pq.o)
            rect((lx - 1) * q, (ly + 1) * q, 3 * q, q, fill: pq.o)
            rect((lx - 1) * q, (ly + 2) * q, 3 * q, 2 * q, fill: yellow)
            rect((lx - 1) * q, (ly + 4) * q, 3 * q, q, fill: pq.o)
          }
          if pose == "sit" {
            let fT = tt % 10
            let ki = len(fishKeys.filter(k => k.t <= fT)) - 1
            let ka = fishKeys[ki]
            let kb = fishKeys[min(ki + 1, len(fishKeys) - 1)]
            let ff = kb.t == ka.t ? 0 : (fT - ka.t) / (kb.t - ka.t)
            let fe = ff * ff * (3 - 2 * ff)
            let reel = fT >= 3.5 && fT < 5.4
            let J = {uaL: lerp(ka.uaL, kb.uaL, fe), faL: lerp(ka.faL, kb.faL, fe), uaR: reel ? 25 + 10 * sin(tt * 11) : lerp(ka.uaR, kb.uaR, fe), faR: reel ? -60 + 45 * sin(tt * 11) : lerp(ka.faR, kb.faR, fe), thL: ka.thL, shL: lerp(ka.shL, kb.shL, fe) + 22 * sin(tt * 2.1), thR: ka.thR, shR: lerp(ka.shR, kb.shR, fe) + 22 * sin(tt * 2.1 + 1.7)}
            let hx = mx + 7
            let hy = my - 18
            let hdx = floor(lerp(ka.hdx, kb.hdx, fe) + 0.5)
            let hdy = floor(lerp(ka.hdy, kb.hdy, fe) + 0.5)
            let eyesK = contains(["left", "down", "right"], ka.eyes) && tt % 3.7 < 0.12 ? "shut" : ka.eyes
            let mouthK = ka.mouth
            let blushOn = ka.mouth == "smile"
            // Pierrot: legs, smock, head and ruff, then the arms in front. Joints are whole cells; sleeves and legs are
            // thick lines between them (an outline pass, then the white).
            let pLegs = [[-1, J.thL, J.shL], [1, J.thR, J.shR]].map(v => {ax: hx + 3 * v[0], ay: hy, a1: v[1], a2: v[2]})
              .map(v => {ax: v.ax, ay: v.ay, bx: v.ax + floor(sin(rad(v.a1)) * 4 + 0.5), by: v.ay + floor(cos(rad(v.a1)) * 4 + 0.5), a2: v.a2})
              .map(v => {s: [[v.ax, v.ay, v.bx, v.by], [v.bx, v.by, v.bx + floor(sin(rad(v.a2)) * 4 + 0.5), v.by + floor(cos(rad(v.a2)) * 4 + 0.5)]]})
            let pArms = [[-1, J.uaL, J.faL], [1, J.uaR, J.faR]].map(v => {ax: hx + 6 * v[0], ay: hy - 10, a1: v[1], a2: v[2]})
              .map(v => {ax: v.ax, ay: v.ay, bx: v.ax + floor(sin(rad(v.a1)) * 5 + 0.5), by: v.ay + floor(cos(rad(v.a1)) * 5 + 0.5), a2: v.a2})
              .map(v => {s: [[v.ax, v.ay, v.bx, v.by], [v.bx, v.by, v.bx + floor(sin(rad(v.a2)) * 5 + 0.5), v.by + floor(cos(rad(v.a2)) * 5 + 0.5)]]})
            for L in pLegs {
              for sg in L.s {
                let n = max(abs(sg[2] - sg[0]), abs(sg[3] - sg[1]), 1)
                for ci in range(n + 1) {
                  let cx = sg[0] + floor((sg[2] - sg[0]) * ci / n + 0.5)
                  let cy = sg[1] + floor((sg[3] - sg[1]) * ci / n + 0.5)
                  rect((cx - 2) * q, (cy - 1) * q, 5 * q, 3 * q, fill: pq.o)
                  rect((cx - 1) * q, (cy - 2) * q, 3 * q, 5 * q, fill: pq.o)
                }
              }
              for sg in L.s {
                let n = max(abs(sg[2] - sg[0]), abs(sg[3] - sg[1]), 1)
                for ci in range(n + 1) {
                  rect((sg[0] + floor((sg[2] - sg[0]) * ci / n + 0.5) - 1) * q, (sg[1] + floor((sg[3] - sg[1]) * ci / n + 0.5) - 1) * q, 3 * q, 3 * q, fill: pq.w)
                }
              }
              let ex = L.s[1][2]
              let ey = L.s[1][3]
              rect((ex - 2) * q, ey * q, 5 * q, 3 * q, fill: pq.o)
              rect((ex - 1) * q, (ey + 1) * q, 3 * q, q, fill: pq.k)
            }
            sprite(pTorso, (hx - 8) * q, (hy - 11) * q, q, palette: pq)
            sprite(pHead, (hx - 6 + hdx) * q, (hy - 25 + hdy) * q, q, palette: pq)
            sprite(get(pEyes, eyesK, pEyes.open), (hx - 4 + hdx) * q, (hy - 19 + hdy) * q, q, palette: pq)
            sprite(get(pMouth, mouthK, pMouth.pout), (hx - 1 + hdx) * q, (hy - 14 + hdy) * q, q, palette: pq)
            rect((hx + 2 + hdx) * q, (hy - 15 + hdy) * q, q, q, fill: pq.t)
            if blushOn {
              rect((hx - 4 + hdx) * q, (hy - 15 + hdy) * q, q, q, fill: pq.c)
              rect((hx + 4 + hdx) * q, (hy - 15 + hdy) * q, q, q, fill: pq.c)
            }
            sprite(pRuff, (hx - 8) * q, (hy - 13) * q, q, palette: pq)
            for L in pArms {
              for sg in L.s {
                let n = max(abs(sg[2] - sg[0]), abs(sg[3] - sg[1]), 1)
                for ci in range(n + 1) {
                  let cx = sg[0] + floor((sg[2] - sg[0]) * ci / n + 0.5)
                  let cy = sg[1] + floor((sg[3] - sg[1]) * ci / n + 0.5)
                  rect((cx - 2) * q, (cy - 1) * q, 5 * q, 3 * q, fill: pq.o)
                  rect((cx - 1) * q, (cy - 2) * q, 3 * q, 5 * q, fill: pq.o)
                }
              }
              for sg in L.s {
                let n = max(abs(sg[2] - sg[0]), abs(sg[3] - sg[1]), 1)
                for ci in range(n + 1) {
                  rect((sg[0] + floor((sg[2] - sg[0]) * ci / n + 0.5) - 1) * q, (sg[1] + floor((sg[3] - sg[1]) * ci / n + 0.5) - 1) * q, 3 * q, 3 * q, fill: pq.w)
                }
              }
              let ex = L.s[1][2]
              let ey = L.s[1][3]
              rect((ex - 2) * q, (ey - 2) * q, 5 * q, 5 * q, fill: pq.o)
              rect((ex - 1) * q, (ey - 1) * q, 3 * q, 3 * q, fill: pq.s)
              rect(ex * q, ey * q, q, q, fill: pq.f)
            }
            // The rod from his left hand; the line from its tip to the hook, bowing a little in the breeze. The hook sits
            // in the window while he waits, comes up with its light (3.5-5.4 s), hangs at the rod, and goes back down
            // (8.4-9.6 s).
            let hand = [pArms[0].s[1][2], pArms[0].s[1][3]]
            let rodA = lerp(ka.rod, kb.rod, fe)
            let tipX = hand[0] + floor(sin(rad(rodA)) * 16 + 0.5)
            let tipY = hand[1] + floor(cos(rad(rodA)) * 16 + 0.5)
            let rn = max(abs(tipX - hand[0]), abs(tipY - hand[1]), 1)
            for ci in range(rn + 1) {
              rect((hand[0] + floor((tipX - hand[0]) * ci / rn + 0.5)) * q, (hand[1] + floor((tipY - hand[1]) * ci / rn + 0.5)) * q, q, q, fill: mix(orange, background, 0.35))
            }
            // The window (a dormer on the long roof): its light spills around it while it's on, pulsing, and flares as
            // it bites; once caught it's dark, until it comes back on, with a flicker, as the hook does.
            let fw = [87, 61]
            let fwLit = mix(orange, foreground, 0.3)
            if fT < 3 || fT >= 9.85 {
              rect((fw[0] - 1) * q, (fw[1] - 1) * q, 3 * q, 4 * q, fill: alpha(yellow, fT < 2.6 || fT >= 9.85 ? 0.16 + 0.06 * sin(tt * 2) : 0.2 + 0.25 * (floor(tt * 16) % 2)))
              rect(fw[0] * q, fw[1] * q, q, 2 * q, fill: fT >= 2.6 && fT < 3 && floor(tt * 16) % 2 == 0 ? foreground : fwLit)
            }
            if (fT >= 3 && fT < 9.7) || (fT >= 9.7 && fT < 9.85 && floor(tt * 20) % 2 == 0) {
              rect(fw[0] * q, fw[1] * q, q, 2 * q, fill: mix(background, blue, 0.26))
            }
            let up = (fT - 3.5) / 1.9
            let dn = min(1, (fT - 8.4) / 1.2)
            let att = fT < 3.5 ? 1 : fT < 5.4 ? 1 - up * up * (3 - 2 * up) : fT < 8.4 ? 0 : dn * dn * (3 - 2 * dn)
            let hkX = floor(tipX + (fw[0] - tipX) * att + 0.5) + (fT >= 3 && fT < 3.6 ? floor(sin(tt * 25) + 0.5) : 0)
            let hkY = floor(tipY + 4 + (fw[1] - 5 - tipY) * att + 0.5)
            let sway = 1.5 * sin(tt * 1.4)
            let ln = max(abs(hkX - tipX), abs(hkY - tipY), 1)
            for ci in range(ln) {
              rect(floor(tipX + (hkX - tipX) * ci / ln + sway * sin(3.14159 * ci / ln) + 0.5) * q, floor(tipY + (hkY - tipY) * ci / ln + 0.5) * q, q, q, fill: alpha(foreground, 0.55))
            }
            rect(hkX * q, hkY * q, q, q, fill: foreground)
            rect((hkX + 1) * q, (hkY - 1) * q, q, q, fill: foreground)
            // The light, caught: a little star the window's colour on the hook, growing as it comes up; then in his
            // hand, then thrown into the sky.
            if fT >= 3 && fT < 5.8 {
              sprite(fT < 4.6 ? starSmall : starBig, (hkX - (fT < 4.6 ? 1 : 2)) * q, hkY * q, q, palette: {y: fT < 4.6 ? fwLit : yellow})
            }
            if fT >= 5.8 && fT < 7.6 {
              let rh = [pArms[1].s[1][2], pArms[1].s[1][3]]
              sprite(starBig, (rh[0] - 2) * q, (rh[1] - 3 - 2) * q, q, palette: {y: yellow})
